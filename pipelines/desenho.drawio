 height="20" as="geometry"/></mxCell><mxCell id="lega" value="&lt;b&gt;1.&lt;/b&gt; Mudança entra por MR/PR, nunca direto na main.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Checagens estáticas e testes do Terraform.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Plan publicado no PR para revisão.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="510" width="560.0" height="57" as="geometry"/></mxCell><mxCell id="legb" value="&lt;b&gt;4.&lt;/b&gt; O plano salvo vira artefato do job.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Ambiente de produção exige aprovação.&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; Apply do mesmo plano, com credencial temporária via OIDC.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="606.0" y="510" width="560.0" height="57" as="geometry"/></mxCell><mxCell id="legn" value="• Mesmo fluxo nas quatro ferramentas; muda só a sintaxe.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="565" width="1120" height="23" as="geometry"/></mxCell><mxCell id="k0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="34" y="619" as="sourcePoint"/><mxPoint x="74" y="619" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt0" value="Fluxo principal" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="82" y="609" width="200" height="20" as="geometry"/></mxCell><mxCell id="k1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="284" y="619" as="sourcePoint"/><mxPoint x="324" y="619" as="targetPoin