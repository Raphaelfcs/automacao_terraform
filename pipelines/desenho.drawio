eometry"/></mxCell><mxCell id="b2_383" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="383" y="134.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b3_551" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="551" y="134.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b4_707" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="707" y="134.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b5_935" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="935" y="134.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b6_1163" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1163" y="134.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="tit" value="&lt;b&gt;Application pipeline with GitOps&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#545B64&quot;&gt;Build, scan, registry and delivery through Argo CD&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1378" height="56" as="geometry"/></mxCell><mxCell id="leg" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#8C99A6;" vertex="1" parent="1"><mxGeometry x="20" y="244" width="1378" height="147" as="geometry"/></mxCell><mxCell id="legt" value="&lt;b&gt;Flow&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="34" y="252" width="300" height="20" as="geometry"/></mxCell><mxCell id="lega" value="&lt;b&gt;1.&lt;/b&gt; Commit triggers tests and build.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Quality and vulnerability gates block the image.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Image goes to ECR with an immutable tag.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="274" width="669.0" height="57" as="geometry"/></mxCell><mxCell id="legb" value="&lt;b&gt;4.&lt;/b&gt; CI opens a PR on the GitOps repository.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Argo CD pulls from Git; CI has no cluster access.&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; Progressive delivery on EKS.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="715.0" y="274" width="669.0" height="57" as="geometry"/></mxCell><mxCell id="k0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="34" y="366" as="sourcePoint"/><mxPoint x="74" y="366" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt0" value="Main flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="82" y="356" width="200" height="20" as="geometry"/></mxCell><mxCell id="k1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="284" y="366" as="sourcePoint"/><mxPoint x="324" y="366" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt1" value="Support, backup or alternative" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="332" y="356" width="200" height="20" as="geometry"/></mxCell><mxCell id="k2" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="545" y="357" width="18" height="18" as="geometry"/></mxCell><mxCell id="kt2" value="Flow step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="582" y="356" width="200" height="20" as="geometry"/></mxCell><mxCell id="k3" value="" style="rounded=1;arcSize=8;html=1;fillColor=none;strokeColor=#8C4FFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="784" y="357" width="40" height="18" as="geometry"/></mxCell><mxCell id="kt3" value="AWS account / VPC / subnet" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="832" y="356" width="200" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
