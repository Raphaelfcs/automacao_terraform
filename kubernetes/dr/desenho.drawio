ht="20" as="geometry"/></mxCell><mxCell id="lega" value="&lt;b&gt;1.&lt;/b&gt; Tráfego controlado por pesos no Route 53.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Velero faz backup diário de manifests e volumes.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="606" width="490.0" height="40" as="geometry"/></mxCell><mxCell id="legb" value="&lt;b&gt;3.&lt;/b&gt; Cluster verde sobe pelo Terraform + Argo CD e restaura os dados.&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Troca de peso gradual; rollback é voltar o peso.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="536.0" y="606" width="490.0" height="40" as="geometry"/></mxCell><mxCell id="legn" value="• Mesmo processo para upgrade de versão do cluster e para DR regional: RPO de 24h com Velero, RTO de horas com GitOps.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="644" width="980" height="23" as="geometry"/></mxCell><mxCell id="k0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="34" y="698" as="sourcePoint"/><mxPoint x="74" y="698" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt0" value="Fluxo principal" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="82" y="688" width="200" height="20" as="geometry"/></mxCell><mxCell id="k1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="284" y="698" as="sourcePoint"/><mxPoint x="324" y="698" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt1" value="Apoio, b