" width="490.0" height="40" as="geometry"/></mxCell><mxCell id="legn" value="• Rolling update for internal services; blue-green when the switch must be atomic; canary for user traffic.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="548" width="980" height="23" as="geometry"/></mxCell><mxCell id="k0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="34" y="602" as="sourcePoint"/><mxPoint x="74" y="602" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt0" value="Main flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="82" y="592" width="200" height="20" as="geometry"/></mxCell><mxCell id="k1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="284" y="602" as="sourcePoint"/><mxPoint x="324" y="602" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt1" value="Support, backup or alternative" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="332" y="592" width="200" height="20" as="geometry"/></mxCell><mxCell id="k2" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="545" y="593" width="18" height="18" as="geometry"/></mxCell><mxCell id="kt2" value="Flow step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="582" y="592" width="200" height="20" as="geometry"/></mxCell><mxCell id="k3" value="" style="rounded=1;arcSize=8;html=1;fillColor=none;strokeColor=#8C4FFF;strokeWidth=1.5;" ver