nt="1"><mxGeometry x="175" y="176.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b2_391" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="391" y="158.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b3_291" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="291" y="194.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b4_391" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="391" y="510.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b5_391" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="391" y="194.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="tit" value="&lt;b&gt;TV program guide monitoring&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#545B64&quot;&gt;Scheduled Python Lambda · AWS&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="876" height="56" as="geometry"/></mxCell><mxCell id="leg" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#8C99A6;" vertex="1" parent="1"><mxGeometry x="20" y="814" width="1020" height="164" as="geometry"/></mxCell><mxCell id="legt" value="&lt;b&gt;Flow&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="34" y="822" width="300" height="20" as="geometry"/></mxCell><mxCell id="lega" value="&lt;b&gt;1.&lt;/b&gt; EventBridge triggers the function three times a day.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; The function reads the official channel list and the daily guide.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Writes the MissingChannels metric (EMF) to CloudWatch.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="844" width="490.0" height="57" as="geometry"/></mxCell><mxCell id="legb" value="&lt;b&gt;4.&lt;/b&gt; Alarm notifies the NOC via SNS; it also fires if the function stops.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; HTML report with missing channels goes out via SES.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="536.0" y="844" width="490.0" height="40" as="geometry"/></mxCell><mxCell id="legn" value="• 2026 version of a 2018 Lambda: no SMTP password in code, only ses:SendEmail permission.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="899" width="980" height="23" as="geometry"/></mxCell><mxCell id="k0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="34" y="953" as="sourcePoint"/><mxPoint x="74" y="953" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt0" value="Main flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="82" y="943" width="200" height="20" as="geometry"/></mxCell><mxCell id="k1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="284" y="953" as="sourcePoint"/><mxPoint x="324" y="953" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt1" 