></mxCell><mxCell id="c22" value="365 d" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#007F85;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="818" y="70" as="sourcePoint" /><mxPoint x="897" y="70" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#007F85;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="222" as="sourcePoint" /><mxPoint x="600" y="158" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#007F85;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="158" as="sourcePoint" /><mxPoint x="935" y="158" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c25" value="Autoclass: desce sem uso e volta ao Standard quando o objeto é lido" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#007F85;" vertex="1" parent="1"><mxGeometry x="612" y="165.5" width="396.925" height="16.5" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="p10" name="EN · 1 · Landing zone (resource tree)"><mxGraphModel dx="1200" dy="612" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="652" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c3" value="&lt;b style=&quot;font-size:14px&quot;&gt;Organization example.com&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5F6368&quot;&gt;Cloud Identity · users and groups synced from Entra ID (SAML + SCIM)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;strokeWidth=1.6;align=left;spacingLeft=52;fontSize=11;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="430.0" y="30.0" width="340.0" height="58.0" as="geometry" /></mxCell><mxCell id="c4" value="" style="shape=image;html=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="440" y="41" width="34" height="34" as="geometry" /></mxCell><mxCell id="c5" value="&lt;b&gt;Org Policies at the root (inherited by everything)&lt;/b&gt;&lt;br&gt;• resourceLocations → southamerica-east1 only&lt;br&gt;• allowedPolicyMemberDomains → example.com only&lt;br&gt;• disableServiceAccountKeyCreation · no automatic grants&lt;br&gt;• vmExternalIpAccess denied · requireOsLogin · no default network&lt;br&gt;• publicAccessPrevention · uniformBucketLevelAccess · restrictPublicIp" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F7F9;strokeColor=#8C99A6;dashed=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="14.0" y="24.0" width="400.0" height="98.0" as="geometry" /></mxCell><mxCell id="c6" value="&lt;b&gt;IAM at the root (groups, never users)&lt;/b&gt;&lt;br&gt;• grp-gcp-org-admins → Organization Admin (2 people + break-glass)&lt;br&gt;• grp-gcp-billing-admins → Billing Account Administrator&lt;br&gt;• grp-gcp-security-admins → Security Center Admin · Org Policy Admin&lt;br&gt;• grp-gcp-auditors → Security Reviewer · Private Logs Viewer&lt;br&gt;• IAM Deny: nobody deletes the log sink or the common folder" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F7F9;strokeColor=#8C99A6;dashed=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="786.0" y="24.0" width="400.0" height="98.0" as="geometry" /></mxCell><mxCell id="c7" value="📁 fldr-bootstrap" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F4F7F9;strokeColor=#8C99A6;da