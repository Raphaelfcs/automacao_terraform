ml=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="619" y="194.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b2_175" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="175" y="552.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="tit" value="&lt;b&gt;Moving a workload between AWS accounts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#545B64&quot;&gt;Current topology, cost and what changes the decision&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="960" height="56" as="geometry"/></mxCell><mxCell id="leg" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#8C99A6;" vertex="1" parent="1"><mxGeometry x="20" y="716" width="1020" height="164" as="geometry"/></mxCell><mxCell id="legt" value="&lt;b&gt;Flow&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="34" y="724" width="300" height="20" as="geometry"/></mxCell><mxCell id="lega" value="&lt;b&gt;1.&lt;/b&gt; Today all human access depends on the current organization Identity Center.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; In the company organization, SCPs and guardrails already exist.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="746" width="490.0" height="40" as="geometry"/></mxCell><mxCell id="legb" value="&lt;b&gt;3.&lt;/b&gt; The VPC moves onto the shared network.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="536.0" y="746" width="490.0" height="23" as="geometry"/></mxCell><mxCell id="legn" value="• Leaving the organization without a break-glass user locks the account: create it first.&lt;br&gt;• Nothing outside sa-east-1, no Route 53 and no ACM: less to move.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="784" width="980" height="40" as="geometry"/></mxCell><mxCell id="k0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="34" y="855" as="sourcePoint"/><mxPoint x="74" y="855" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt0" value="Main flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="82" y="845" width="200" height="20" as="geometry"/></mxCell><mxCell id="k1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="284" y="855" as="sourcePoint"/><mxPoint x="324" y="855" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt1" value="Support, backup or alternative" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="332" y="845" width="200" height="20" as="geometry"/></mxCell><mxCell id="k2" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="545" y="846" width="18" height="18" as="geometry"/></mxCell><mxCell id="kt2" value="Flow step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="582" y="845" width="200" height="20" as="geometry"/></mxCell><mxCell id="k3" value="" style="rounded=1;arcSize=8;html=1;fillCol