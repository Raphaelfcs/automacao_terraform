        <mxCell id="i31" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F34482;gradientDirection=north;fillColor=#BC1356;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;" vertex="1" parent="gsh"><mxGeometry x="500" y="112" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="i31t" value="&lt;b&gt;CloudWatch&lt;/b&gt;&lt;br&gt;12 log groups · 41 GiB" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;fillColor=none;spacingLeft=2;" vertex="1" parent="gsh"><mxGeometry x="554" y="110" width="180" height="52" as="geometry" /></mxCell>
        <mxCell id="gparc" value="&lt;b&gt;Conta 111122223333  (externa — Empresa)&lt;/b&gt;" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud;strokeColor=#7D8998;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;spacingTop=3;fontColor=#5A6C7D;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="1156" width="560" height="120" as="geometry" /></mxCell>
        <mxCell id="i32" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#945DF2;gradientDirection=north;fillColor=#5A30B5;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.transit_gateway;" vertex="1" parent="gparc"><mxGeometry x="24" y="40" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="i32t" value="&lt;b&gt;2 Transit Gateways&lt;/b&gt;&lt;br&gt;tgw-0123456789abcdef0&lt;br&gt;tgw-0123456789abcdef0" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;strokeColor=none;fillColor=none;spacingLeft=2;" vertex="1" parent="gparc"><mxGeometry x="78" y="38" width="240" height="52" as="geometry" /></mxCell>
        <mxCell id="parcnota" value="&lt;b&gt;Peering ACEITO com o TGW desta conta.&lt;/b&gt;&lt;br&gt;Mover a conta PRESERVA (é cross-account). Recriar exige a Empresa refazer os dois lados." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#EAF6EC;strokeColor=#1D8102;fontColor=#232F3E;arcSize=8;" vertex="1" parent="gparc"><mxGeometry x="320" y="36" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="ar1" value="2 × peering de TGW (cross-account)" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=2;strokeColor=#5A30B5;fontSize=10;fontColor=#232F3E;rounded=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="gparc" target="i25"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel></diagram><diagram id="p1" name="Custos"><mxGraphModel dx="1422" dy="794" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2tit" value="&lt;b&gt;Custo — conta 111122223333&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="800" height="34" as="geometry" /></mxCell>
        <mxCell id="p2sub" value="AWS Cost Explorer, UnblendedCost, coletado em 2026-10-19. Médias diárias de 16–18/out (os três dias completos após a pausa de 15/10)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6C7D;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1100" height="20" as="geometry" /></mxCell>
        <mxCell id="c1" value="&lt;b&gt;1. Histórico mensal da conta inteira  (US$)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#F7F9FA;strokeColor=#AAB7B8;fontColor=#232F3E;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="86" width="1000" height="266" as="geometry" /></mxCell>
        <mxCell id="m0" value="&lt;b&gt;abr/26   US$ 18,84&lt;/b&gt;  — primeiro mês com custo: ECR + EC2 pontual" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#FFFFFF;strokeColor=#AAB7B8;fontColor=#232F3E;arcSize=8;" vertex="1" parent="c1"><mxGeometry x="16" y="36" width="968" height="26" as="geometry" /></mxCell>
        <mxCell id="m1" value="&lt;b&gt;mai/26   US$ 180,98&lt;/b&gt;  — VPC e NAT entram em operação" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#FFFFFF;strokeColor=#AAB7B8;fontColor=#232F3E;arcSize=8;" vertex="1" parent="c1"><mxGeometry x="16" y="66" width="968" height="26" as="geometry" /></mxCell>
        <mxCell id="m2" value="&lt;b&gt;jun/26   US$ 630,71&lt;/b&gt;  — EKS plataforma-eks-cluster-staging (18/06) + RDS (24/06)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#FFFFFF;strokeColor=#AAB7B8;fontColor=#232F3E;arcSize=8;" vertex="1" parent="c1"><mxGeometry x="16" y="96" width="968" height="26" as="geometry" /></mxCell>
        <mxCell id="m3" value="&lt;b&gt;jul/26   US$ 1.370,25&lt;/b&gt;  — node groups cheios + 2 ALB" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#FFFFFF;strokeColor=#AAB7B8;fontColor=#232F3E;arcSize=8;" vertex="1" parent="c1"><mxGeometry x="16" y="126" width="968" height="26" as="geometry" /></mxCell>
        <mxCell id="m4" value="&lt;b&gt;ago/26   US$ 1.617,39&lt;/b&gt;  — regime estável de 1 cluster" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#FFFFFF;strokeColor=#AAB7B8;fontColor=#232F3E;arcSize=8;" vertex="1" parent="c1"><mxGeometry x="16" y="156" width="968" height="26" as="geometry" /></mxCell>
        <mxCell id="m5" value="&lt;b&gt;set/26   US$ 1.939,76&lt;/b&gt;  — + cluster de data analytics (28/09) — ÚLTIMO MÊS 100% Empresa" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#EAF6EC;strokeColor=#1D8102;fontColor=#232F3E;arcSize=8;" vertex="1" parent="c1"><mxGeometry x="16" y="186" width="968" height="26" as="geometry" /></mxCell>
        <mxCell id="m6" value="&lt;b&gt;out/26   US$ 2.088,09&lt;/b&gt;  — parcial 1–18/10. Entram Empresa (09/10), cicd (13/10), monitoring (14/10); pausa em 15/10" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#FFFFFF;strokeColor=#AAB7B8;fontColor=#232F3E;arcSize=8;" vertex="1" parent="c1"><mxGeometry x="16" y="216" width="968" height="26" as="geometry" /></mxCell>
        <mxCell id="macum" value="&lt;b&gt;Acumulado de abril a 18/out:  US$ 7.846,02&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#EAF6EC;strokeColor=#1D8102;fontColor=#232F3E;arcSize=8;" vertex="1" parent="c1"><mxGeometry x="16" y="248" width="968" height="26" as="geometry" /></mxCell>
        <mxCell id="c2" value="&lt;b&gt;2. Quanto custa hoje, por projeto&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#F7F9FA;strokeColor=#AAB7B8;fontColor=#232F3E;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1040" y="86" width="520" height="266" as="geometry" /></mxCell>
        <mxCell id="c2a" value="&lt;b&gt;stage do Empresa  (Project=plataforma-Empresa)&lt;/b&gt;&lt;br&gt;tag: 32,16/dia  +  rateio do sem-tag: ~15,80/dia&lt;br&gt;≈ US$ 48/dia   →   ~US$ 1.450/mês" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#E8F0FE;strokeColor=#4D72F3;fontColor=#232F3E;arcSize=8;" vertex="1" parent="c2"><mxGeometry x="16" y="36" width="488" height="58" as="geometry" /></mxCell>
        <mxCell id="c2b" value="&lt;b&gt;Empresa-stg&lt;/b&gt;&lt;br&gt;tag: 44,30/dia  +  rateio do sem-tag: ~12,40/dia&lt;br&gt;≈ US$ 57/dia   →   ~US$ 1.700/mês" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#FFF4E5;strokeColor=#FF9900;fontColor=#232F3E;arcSize=8;" vertex="1" parent="c2"><mxGeometry x="16" y="100" width="488" height="58" as="geometry" /></mxCell>
        <mxCell id="c2c" value="&lt;b&gt;Imposto&lt;/b&gt;&lt;br&gt;~US$ 255/mês, lançado no dia 1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#F7F9FA;strokeColor=#AAB7B8;fontColor=#232F3E;arcSize=8;" vertex="1" parent="c2"><mxGeometry x="16" y="164" width="488" height="42" as="geometry" /></mxCell>
        <mxCell id="c2d" value="&lt;b&gt;Conta total:  ~US$ 3.150/mês + imposto  ≈  US$ 3.400/mês&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#EAF6EC;strokeColor=#1D8102;fontColor=#232F3E;arcSize=8;" vertex="1" parent="c2"><mxGeometry x="16" y="212" width="488" height="30" as="geometry" /></mxCell>
        <mxCell id="c3" value="&lt;b&gt;3. Efeito da pausa de 15/10 no stage do Empresa&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#F7F9FA;strokeColor=#AAB7B8;fontColor=#232F3E;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="372" width="1000" height="176" as="geometry" /></mxCell>
        <mxCell id="c3a" value="&lt;b&gt;Antes da pausa (15/10, 4 clusters de pé):   ~US$ 90/dia  →  ~US$ 2.700/mês&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#E8F0FE;strokeColor=#4D72F3;fontColor=#232F3E;arcSize=8;" vertex="1" parent="c3"><mxGeometry x="16" y="36" width="968" height="28" as="geometry" /></mxCell>
        <mxCell id="c3b" value="&lt;b&gt;Depois da pausa (16–18/10):   ~US$ 48/dia  →  ~US$ 1.450/mês        corte de 46%&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#EAF6EC;strokeColor=#1D8102;fontColor=#232F3E;arcSize=8;" vertex="1" parent="c3"><mxGeometry x="16" y="70" width="968" height="28" as="geometry" /></mxCell>
        <mxCell id="c3c" value="&lt;b&gt;O que NÃO para de faturar com 0 nós e RDS parado&lt;/b&gt;&lt;br&gt;5 control planes EKS (~US$ 0,10/h cada) · 4 NAT Gateways · 11 Load Balancers&lt;br&gt;705 GiB de EBS — dos quais 367 GiB em 20 volumes órfãos · 50 GiB do RDS parado · 41 GiB de logs" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#FDE8E9;strokeColor=#D13212;fontColor=#232F3E;arcSize=8;" vertex="1" parent="c3"><mxGeometry x="16" y="104" width="968" height="58" as="geometry" /></mxCell>
        <mxCell id="c4" value="&lt;b&gt;4. Por que o rateio é estimativa, e não medição&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#FDE8E9;strokeColor=#D13212;fontColor=#232F3E;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1040" y="372" width="520" height="176" as="geometry" /></mxCell>
        <mxCell id="c4a" value="&lt;b&gt;As tags de alocação de custo NÃO estão ativas.&lt;/b&gt;&lt;br&gt;list-cost-allocation-tags nega acesso na conta membro — só a conta de gestão ativa.&lt;br&gt;Resultado: ~27% do custo cai num balde sem tag Project, porque a AWS não propaga&lt;br&gt;tag para o que ela mesma cria (os 11 LB vêm do Load Balancer Controller, os nós do ASG)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#F7F9FA;strokeColor=#AAB7B8;fontColor=#232F3E;arcSize=8;" vertex="1" parent="c4"><mxGeometry x="16" y="36" width="488" height="78" as="geometry" /></mxCell>
        <mxCell id="c4b" value="&lt;b&gt;Atribuí por tipo de uso: 3 t3.large (2 Empresa + 1 legado Empresa),&lt;/b&gt;&lt;br&gt;11 LB rateados 9:2, endpoints por VPC. A ordem de grandeza está certa; os centavos não." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#F7F9FA;strokeColor=#AAB7B8;fontColor=#232F3E;arcSize=8;" vertex="1" parent="c4"><mxGeometry x="16" y="120" width="488" height="44" as="geometry" /></mxCell>
        <mxCell id="c5" value="&lt;b&gt;5. Composição do balde sem tag  —  ~US$ 28,50/dia&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#F7F9FA;strokeColor=#AAB7B8;fontColor=#232F3E;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="568" width="1540" height="120" as="geometry" /></mxCell>
        <mxCell id="u0" value="&lt;b&gt;US$ 9,68/dia&lt;/b&gt;&lt;br&gt;3 × t3.large&lt;br&gt;2 nós do EKS do Empresa (ASG) + 1 EC2 legada do Empresa" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#FFFFFF;strokeColor=#AAB7B8;fontColor=#232F3E;arcSize=8;" vertex="1" parent="c5"><mxGeometry x="16" y="36" width="292" height="70" as="geometry" /></mxCell>
        <mxCell id="u1" value="&lt;b&gt;US$ 7,34/dia&lt;/b&gt;&lt;br&gt;11 Load Balancers&lt;br&gt;criados pelo AWS Load Balancer Controller" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#FFFFFF;strokeColor=#AAB7B8;fontColor=#232F3E;arcSize=8;" vertex="1" parent="c5"><mxGeometry x="320" y="36" width="292" height="70" as="geometry" /></mxCell>
        <mxCell id="u2" value="&lt;b&gt;US$ 6,48/dia&lt;/b&gt;&lt;br&gt;VPC (NAT + endpoints)&lt;br&gt;NAT do Empresa + 13 VPC endpoints" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#FFFFFF;strokeColor=#AAB7B8;fontColor=#232F3E;arcSize=8;" vertex="1" parent="c5"><mxGeometry x="624" y="36" width="292" height="70" as="geometry" /></mxCell>
        <mxCell id="u3" value="&lt;b&gt;US$ 2,91/dia&lt;/b&gt;&lt;br&gt;EC2 - Other (EBS)&lt;br&gt;volumes órfãos, em boa parte" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#FFFFFF;strokeColor=#AAB7B8;fontColor=#232F3E;arcSize=8;" vertex="1" parent="c5"><mxGeometry x="928" y="36" width="292" height="70" as="geometry" /></mxCell>
        <mxCell id="u4" value="&lt;b&gt;US$ 1,90/dia&lt;/b&gt;&lt;br&gt;t3.medium + t3.micro&lt;br&gt;k3s legado do Empresa + ec2-bastion-Empresa" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#FFFFFF;strokeColor=#AAB7B8;fontColor=#232F3E;arcSize=8;" vertex="1" parent="c5"><mxGeometry x="1232" y="36" width="292" height="70" as="geometry" /></mxCell>
      </root>
    </mxGraphModel></diagram><diagram id="p2" name="Achados"><mxGraphModel dx="1422" dy="794" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3tit" value="&lt;b&gt;Achados que mudam a decisão&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="900" height="34" as="geometry" /></mxCell>
        <mxCell id="p3sub" value="Cada item abaixo saiu da varredura, não de suposição. O documento MIGRACAO-ORG.md traz o passo a passo e o trade-off completo." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6C7D;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1100" height="20" as="geometry" /></mxCell>
        <mxCell id="a0" value="&lt;b&gt;1. A conta NÃO é só do Empresa.&lt;/b&gt;&lt;br&gt;O projeto Empresa-stg nasceu em 2026-10-09 e hoje responde por ~54% do custo.&lt;br&gt;Mover a conta para a Empresa move o Empresa junto, com a fatura. É decisão comercial, não técnica." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#FDE8E9;strokeColor=#D13212;fontColor=#232F3E;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="500" height="96" as="geometry" /></mxCell>
        <mxCell id="a1" value="&lt;b&gt;2. O Transit Gateway é desta conta.&lt;/b&gt;&lt;br&gt;tgw-0123456789abcdef0 faz peering com DOIS TGW da conta 111122223333.&lt;br&gt;Mover preserva os peerings (são cross-account). Recriar exige ação da Empresa nos dois lados." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#FDE8E9;strokeColor=#D13212;fontColor=#232F3E;arcSize=8;" vertex="1" parent="1"><mxGeometry x="540" y="90" width="500" height="96" as="geometry" /></mxCell>
        <mxCell id="a2" value="&lt;b&gt;3. Zero usuários IAM.&lt;/b&gt;&lt;br&gt;Todo acesso humano vem do Identity Center da organização da Empresa.&lt;br&gt;Ao sair da org o único role AWSReservedSSO_* morre — exige break-glass criado ANTES." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#FDE8E9;strokeColor=#D13212;fontColor=#232F3E;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1060" y="90" width="500" height="96" as="geometry" /></mxCell>
        <mxCell id="a3" value="&lt;b&gt;4. Nenhuma policy amarrada ao ID da org.&lt;/b&gt;&lt;br&gt;Varri 41 policies locais, 70 roles (trust e inline) e 4 bucket policies:&lt;br&gt;zero ocorrências de aws:PrincipalOrgID ou o-exemplo123. Nenhum recurso quebra ao trocar de org." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#EAF6EC;strokeColor=#1D8102;fontColor=#232F3E;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="500" height="96" as="geometry" /></mxCell>
        <mxCell id="a4" value="&lt;b&gt;5. Desperdício já identificado.&lt;/b&gt;&lt;br&gt;20 volumes EBS em estado available (órfãos) somando 367 GiB de 705 GiB totais.&lt;br&gt;2 EC2 legadas rodando na VPC 10.0.0.0/16. 1 bastion não pausado." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#FDE8E9;strokeColor=#D13212;fontColor=#232F3E;arcSize=8;" vertex="1" parent="1"><mxGeometry x="540" y="200" width="500" height="96" as="geometry" /></mxCell>
        <mxCell id="a5" value="&lt;b&gt;6. Não existe SQS nesta conta.&lt;/b&gt;&lt;br&gt;Zero filas em sa-east-1, us-east-1, us-east-2, us-west-2 e eu-west-1. Zero SNS, zero Lambda.&lt;br&gt;O desenho de eventos de rede em SQS não tem recurso correspondente hoje — é projeto, não ambiente." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#FFF4E5;strokeColor=#FF9900;fontColor=#232F3E;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1060" y="200" width="500" height="96" as="geometry" /></mxCell>
        <mxCell id="a6" value="&lt;b&gt;7. Nada fora de sa-east-1.&lt;/b&gt;&lt;br&gt;EC2, EKS, RDS e VPCs não-default: zero em 8 regiões verificadas.&lt;br&gt;Sem Route 53, sem ACM — não há DNS nem certificado a migrar." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#EAF6EC;strokeColor=#1D8102;fontColor=#232F3E;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="310" width="500" height="96" as="geometry" /></mxCell>
        <mxCell id="a7" value="&lt;b&gt;8. Não consegui ler as SCPs.&lt;/b&gt;&lt;br&gt;list-policies-for-target e describe-account negam acesso a partir da conta membro.&lt;br&gt;Precisa ser consultado na conta de gestão 111122223333 ANTES de mover." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#FDE8E9;strokeColor=#D13212;fontColor=#232F3E;arcSize=8;" vertex="1" parent="1"><mxGeometry x="540" y="310" width="500" height="96" as="geometry" /></mxCell>
        <mxCell id="a8" value="&lt;b&gt;9. Custo da conta hoje: ~US$ 105/dia.&lt;/b&gt;&lt;br&gt;~US$ 3.150/mês + ~US$ 255 de imposto. Acumulado desde abril/2026: US$ 7.846.&lt;br&gt;O stage do Empresa pausado é ~US$ 1.450/mês; de pé, ~US$ 2.700/mês." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#F7F9FA;strokeColor=#AAB7B8;fontColor=#232F3E;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1060" y="310" width="500" height="96" as="geometry" /></mxCell>
        <mxCell id="p3rec" value="&lt;b&gt;Recomendação&lt;/b&gt;&lt;br&gt;Mover a conta de organização (preserva tudo, zero downtime, 1–2 semanas) — condicionado a resolver antes o destino do Empresa.&lt;br&gt;O híbrido merece consideração: tirar o Empresa desta conta primeiro recria um projeto de 10 dias em vez de um de 6 meses,&lt;br&gt;e resolve de brinde a sobreposição de 10.1.0.0/16 entre as duas VPCs." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=8;spacingTop=5;fillColor=#EAF6EC;strokeColor=#1D8102;fontColor=#232F3E;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="1540" height="80" as="geometry" /></mxCell>
      </root>
    </mxGraphModel></diagram></mxfile>
