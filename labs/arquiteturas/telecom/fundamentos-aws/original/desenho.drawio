        <mxCell id="yFUZICdSafYMst8AWGUK-38" value="Tamanho máximo por Objeto é&amp;nbsp;&lt;br&gt;&lt;font color=&quot;#ff0000&quot;&gt;5&amp;nbsp;TB&lt;/font&gt;&lt;br&gt;&lt;br&gt;Podemos Subir de uma vez por PUT&amp;nbsp;&lt;br&gt;&lt;font color=&quot;#ff0000&quot;&gt;5GB&lt;br&gt;Para arquivos acima de 100M&amp;nbsp;&lt;br&gt;E com internet ou meios ruins&amp;nbsp;&lt;br&gt;devemos considerar&amp;nbsp;&lt;br&gt;Carregamento fracionado&lt;br&gt;&lt;br&gt;S3 MULTPART&lt;br&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
