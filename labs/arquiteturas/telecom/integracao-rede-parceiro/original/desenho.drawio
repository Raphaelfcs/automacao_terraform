        <mxCell id="legPend" value="PENDÊNCIAS DE REDE: rota de volta 10.1.0.0/16 no TGW da Empresa · por qual peering chega 172.31.0.0/16 · TLS no ALB      |      NÃO É REDE: client_secret retido (MENSAGENS #20) · grant de marca por cliente (TMF-SEC-004)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontColor=#232F3E;" vertex="1" parent="gLeg">
