        <mxCell id="p1-note" value="Um inventário que só lê terraform.tfstate ignora toda a stack de observabilidade.&#10;A leitura cruzada é permitida; escrita cruzada entre raízes, nunca." style="text;html=1;fontSize=11;align=left;verticalAlign=top;fontColor=#a8480f;" parent="1" vertex="1">
          <mxGeometry x="40" y="500" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p1-immut" value="&lt;b&gt;Módulos imutáveis:&lt;/b&gt; vpc, eks, node-groups, iam, addons.&lt;br&gt;Capacidade nova entra como módulo novo e isolado, consumindo os outputs deles por variável." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=none;dashed=1;fontSize=11;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="590" width="1000" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel></diagram><diagram id="p2" name="02 Rede e security groups"><mxGraphModel dx="8425" dy="2304" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2-title" value="Quem alcança quem — toda regra vive no SG do destino, com o SG de origem como referência" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2-vpc" value="VPC 10.1.0.0/16 · 3 AZs · subnets privadas · NAT por AZ" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="40" y="70" width="1100" height="500" as="geometry" />
        </mxCell>
        <mxCell id="p2-nodes" value="&lt;b&gt;EKS — node groups&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;apps · m5.large · 3 nós (ADR-042)&lt;br&gt;system · t3.medium · taint CriticalAddonsOnly&lt;br&gt;&lt;br&gt;o SG dos nós é a origem autorizada abaixo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="90" y="130" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2-cp" value="&lt;b&gt;Control plane EKS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;endpoint privado + público&lt;br&gt;público restrito a IPs /32&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="440" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-rds" value="&lt;b&gt;RDS PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;db.t4g.medium · Single-AZ&lt;br&gt;privado · force_ssl = 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="800" y="140" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-cache" value="&lt;font style=&quot;font-size: 14px;&quot; color=&quot;#3399ff&quot;&gt;&lt;b style=&quot;&quot;&gt;ElastiCache Redis&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;1 nó · cache.t4g.micro&lt;br&gt;TLS + auth_token · KMS própria&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#CCFFFF;strokeColor=#a8480f;" parent="1" vertex="1">
          <mxGeometry x="800" y="300" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-bastion" value="&lt;b&gt;Bastion (somente SSM)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;sem porta 22, sem IP público&lt;br&gt;SG sem nenhuma regra de ingress&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="490" y="440" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-e1" value="5432/tcp — origem: SG dos nós" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" parent="1" source="p2-nodes" target="p2-rds" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e2" value="6379/tcp — SG dos nós + SG do cluster" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#a8480f;fontColor=#a8480f;fontSize=10;" parent="1" source="p2-nodes" target="p2-cache" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="230" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-e3" value="6379/tcp — SG do bastion" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#a8480f;fontColor=#a8480f;fontSize=10;" parent="1" source="p2-bastion" target="p2-cache" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e4" value="443 — kubectl" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" parent="1" source="p2-bastion" target="p2-cp" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e5" value="sem regra de ingress — lacuna real" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=cross;endFill=0;strokeColor=#a8480f;fontColor=#a8480f;fontSize=10;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="p2-bastion" target="p2-rds" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="770" y="510" />
              <mxPoint x="1100" y="510" />
              <mxPoint x="1100" y="270" />
              <mxPoint x="940" y="270" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-note-lb" value="Load balancers apenas internos, em duas camadas: a tag kubernetes.io/role/elb foi removida das subnets públicas (o LBC não consegue descobrir subnet para LB internet-facing) e a IngressClass alb-internal é a default." style="text;html=1;fontSize=11;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="60" y="540" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2-note-destroy" value="&lt;b&gt;Por que isso importa no destroy:&lt;/b&gt; como as regras ficam no SG do recurso de destino, destruir o cache remove só o SG dele e suas regras — nada do EKS é alterado, e não sobra regra órfã.&#10;&#10;O X marca uma divergência: o roteiro de verificação do bastion pede nc -zv &amp;lt;rds&amp;gt; 5432, mas o SG do RDS só libera o SG dos nós." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=none;dashed=1;fontSize=11;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="600" width="1080" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel></diagram><diagram id="p3" name="03 Permissões do IaC"><mxGraphModel dx="2627" dy="1191" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3-title" value="Permissões — quatro identidades, caminhos que não se cruzam" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3-sub" value="Nenhuma identidade acumula os dois poderes: criar infraestrutura e entregar aplicação." style="text;html=1;fontSize=11;fontColor=#666666;align=left;" parent="1" vertex="1">
          <mxGeometry x="40" y="50" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p3-h1" value="identidade" style="text;html=1;fontSize=11;fontColor=#666666;align=left;" parent="1" vertex="1">
          <mxGeometry x="60" y="85" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p3-h2" value="alvo" style="text;html=1;fontSize=11;fontColor=#666666;align=left;" parent="1" vertex="1">
          <mxGeometry x="780" y="85" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p3-op" value="&lt;b&gt;Operador (SSO)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;terraform, na própria máquina&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="110" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3-aws" value="&lt;b&gt;APIs da AWS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;cria e altera infra · state no S3 + lock&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="780" y="110" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3-e1" value="plan revisado por humano · apply sempre manual" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#a8480f;fontColor=#a8480f;fontSize=10;" parent="1" source="p3-op" target="p3-aws" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-ci" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;OIDC, sem chave estática&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="230" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3-ecr" value="&lt;b&gt;ECR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;repositórios de imagem&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="780" y="230" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3-e2" value="push de imagem — e nada além.&lt;br&gt;&lt;b&gt;o CI não faz deploy&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" parent="1" source="p3-ci" target="p3-ecr" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-argo" value="&lt;b&gt;ArgoCD (no cluster)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;deploy key SSH de leitura&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="350" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3-git" value="&lt;b&gt;Estado desejado (git)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;app-of-apps · sync waves&lt;br&gt;migrations = hook PreSync, wave 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="780" y="350" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3-e3" value="puxa — entrega é pull-based" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" parent="1" source="p3-git" target="p3-argo" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-irsa" value="&lt;b&gt;Pods via IRSA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;cluster-autoscaler · aws-lbc&lt;br&gt;external-dns · External Secrets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="470" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3-sm" value="&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;plataforma-Empresa/&amp;lt;env&amp;gt;/db/* — e só esse prefixo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#fdf1e7;strokeColor=#a8480f;" parent="1" vertex="1">
          <mxGeometry x="780" y="470" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3-e4" value="GetSecretValue, escopo fechado por prefixo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#a8480f;fontColor=#a8480f;fontSize=10;" parent="1" source="p3-irsa" target="p3-sm" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-bastion" value="&lt;b&gt;Bastion:&lt;/b&gt; SSM + eks:DescribeCluster + logs da própria sessão. O cluster-admin não vem de IAM — vem do EKS access entry." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=none;dashed=1;fontSize=11;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="580" width="1020" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3-gap" value="&lt;b&gt;O escopo do ESO é o teto de qualquer segredo novo.&lt;/b&gt; A senha do ElastiCache fica fora de plataforma-Empresa/&amp;lt;env&amp;gt;/db/*, e modules/iam é imutável — logo não há sincronização automática para um Secret do Kubernetes até existir uma mudança dedicada. Decisão pendente, não esquecimento." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#fdf1e7;strokeColor=#a8480f;fontSize=11;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="650" width="1020" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel></diagram><diagram id="p4" name="04 Gates de IaC"><mxGraphModel dx="1251" dy="567" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4-title" value="Gates que valem para qualquer mudança de IaC" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p4-g1" value="&lt;b&gt;Nenhum apply sem revisão humana do plan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Agente prepara o plan e para. apply e destroy ficam fora do Makefile de propósito.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="70" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4-g2" value="&lt;b&gt;Módulos imutáveis&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;vpc, eks, node-groups, iam, addons. Capacidade nova só em módulo novo e isolado.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="600" y="70" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4-g3" value="&lt;b&gt;Fronteira de state&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Nunca reaproveitar state entre raízes. Leitura cruzada só por terraform_remote_state.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="170" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4-g4" value="&lt;b&gt;Segredo nunca em arquivo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Injeção por variável de ambiente ou Secrets Manager. Plan salvo embute segredo — *.tfplan e tfplan* ignorados.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fillColor=#fdf1e7;strokeColor=#a8480f;" parent="1" vertex="1">
          <mxGeometry x="600" y="170" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4-g5" value="&lt;b&gt;terraform.tfvars não é versionado&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Cada operador mantém o seu. Divergir do implantado gera drift que só o plan completo revela.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="270" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4-g6" value="&lt;b&gt;Plan escopado não substitui plan completo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;-target esconde drift fora do alvo. Serve para focar revisão, não para aprovar mudança.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="600" y="270" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4-src" value="Levantado do código em infra/v2, infra/observability e .kiro/steering/. Onde documentação e código divergiam, o código prevaleceu." style="text;html=1;fontSize=11;fontColor=#666666;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="380" width="1080" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel></diagram></mxfile>
