v78"><mxGeometry x="66" y="6" width="312" height="204" as="geometry" /></mxCell><mxCell id="v81" value="" style="fontColor=#0066CC;verticalAlign=top;verticalLabelPosition=bottom;labelPosition=center;align=center;html=1;outlineConnect=0;fillColor=#CCCCCC;strokeColor=#6881B3;gradientColor=none;gradientDirection=north;strokeWidth=2;shape=mxgraph.networks.router;" vertex="1" parent="1"><mxGeometry x="370" y="1296" width="56" height="56" as="geometry" /></mxCell><mxCell id="v82" value="&lt;b&gt;Roteadores de borda&lt;/b&gt;&lt;br&gt;BGP com a Empresa&lt;br&gt;e com o trânsito IP" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;spacing=2;" vertex="1" parent="1"><mxGeometry x="308.0" y="1356" width="180" height="110" as="geometry" /></mxCell><mxCell id="v83" value="Ambiente dev (VMs no mesmo cluster Proxmox, VRF própria)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#7F6000;fillColor=none;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;fontStyle=1;" vertex="1" parent="v11"><mxGeometry x="220" y="1112" width="900" height="300" as="geometry" /></mxCell><mxCell id="v84" value="" style="fontColor=#0066CC;verticalAlign=top;verticalLabelPosition=bottom;labelPosition=center;align=center;html=1;outlineConnect=0;fillColor=#CCCCCC;strokeColor=#6881B3;gradientColor=none;gradientDirection=north;strokeWidth=2;shape=mxgraph.networks.server;" vertex="1" parent="1"><mxGeometry x="550" y="1290" width="46" height="46" as="geometry" /></mxCell><mxCell id="v85" value="&lt;b&gt;VM 2 vCPU / 4 GB&lt;/b&gt;&lt;br&gt;k3s (mesmo user-data)&lt;br&gt;MetalLB L2 para SCTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v83"><mxGeometry x="82" y="54" width="222" height="236" as="geometry" /></mxCell><mxCell id="v86" value="" style="fontColor=#0066CC;verticalAlign=top;verticalLabelPosition=bottom;labelPosition=center;align=center;html=1;outlineConnect=0;fillColor=#CCCCCC;strokeColor=#6881B3;gradientColor=none;gradientDirection=north;strokeWidth=2;shape=mxgraph.networks.server;" vertex="1" parent="1"><mxGeometry x="842" y="1290" width="46" height="46" as="geometry" /></mxCell><mxCell id="v87" value="&lt;b&gt;VM 2 vCPU / 8 GB&lt;/b&gt;&lt;br&gt;Pinot dev" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v83"><mxGeometry x="374" y="54" width="222" height="236" as="geometry" /></mxCell><mxCell id="v88" value="" style="fontColor=#0066CC;verticalAlign=top;verticalLabelPosition=bottom;labelPosition=center;align=center;html=1;outlineConnect=0;fillColor=#CCCCCC;strokeColor=#6881B3;gradientColor=none;gradientDirection=north;strokeWidth=2;shape=mxgraph.networks.router;" vertex="1" parent="1"><mxGeometry x="1134" y="1290" width="46" height="46" as="geometry" /></mxCell><mxCell id="v89" value="&lt;b&gt;VRF dev&lt;/b&gt;&lt;br&gt;isolada de staging no firewall&lt;br&gt;roteada para o lab da Empresa" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v83"><mxGeometry x="666" y="54" width="222" height="236" as="geometry" /></mxCell><mxCell id="v90" value="&lt;b&gt;Como tudo funcionaria on-premises&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Terraform continua&lt;/b&gt;: providers proxmox (bpg/proxmox), netbox, keycloak, vault e helm; state no Ceph RGW (backend S3 com &lt;i&gt;use_lockfile&lt;/i&gt;).&lt;br&gt;• &lt;b&gt;Identidade de workload&lt;/b&gt; (substitui IRSA): OpenBao Kubernetes auth + ESO; SPIFFE/SPIRE se for preciso mTLS entre serviços (ajuda a fechar TD-003/006).&lt;br&gt;• &lt;b&gt;HA&lt;/b&gt; passa a ser responsabilidade do time: quórum etcd/Ceph exige ≥3 hosts, peças de reposição, firmware e janelas de manutenção.&lt;br&gt;• &lt;b&gt;Vantagem&lt;/b&gt;: SCTP com IP de LoadBalancer, latência mínima até o core da Empresa, custo previsível e dados dentro da operadora (LGPD, retenção de CDR).&lt;br&gt;• &lt;b&gt;Desvantagem&lt;/b&gt;: CAPEX, prazo de compra e importação (8–16 semanas), elasticidade zero, 24×7 com plantão próprio.&lt;br&gt;• Desligar à noite &lt;b&gt;não economiza&lt;/b&gt;: o custo é fixo." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;strokeColor=#D6B656;fillColor=#FFF9E6;strokeWidth=1.5;spacingTop=6;spacingRight=8;" vertex="1" parent="v11"><mxGeometry x="1140" y="1112" width="920" height="300" as="geometry" /></mxCell><mxCell id="e91" value="push → Harbor (runner self-hosted ou túnel)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;fontColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="v4" target="v13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e92" value="VPN + Teleport" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;fontColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.55;" edge="1" parent="1" source="v6" target="v29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e93" value="saída 0.0.0.0/0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;fontColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v30" target="v2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e94" value="Diameter Ro/Gy/Sy (SCTP)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;fontColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="v8" target="v81"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e95" value="VRF dev" style="edgeStyle=orthogonalEdgeStyl