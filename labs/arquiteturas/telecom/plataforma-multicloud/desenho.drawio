wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#4285F4;fillColor=#FFFFFF;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;fontStyle=1;" vertex="1" parent="v45"><mxGeometry x="512" y="40" width="476" height="400" as="geometry" /></mxCell><mxCell id="v52" value="" style="sketch=0;html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=11;fontColor=#424242;shape=mxgraph.gcp2.hexIcon;prIcon=container_engine;" vertex="1" parent="1"><mxGeometry x="864" y="536" width="46" height="40" as="geometry" /></mxCell><mxCell id="v53" value="&lt;b&gt;gke-plataforma-workload&lt;/b&gt;&lt;br&gt;GKE Standard 1.35 · privado · charging" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=12;" vertex="1" parent="v51"><mxGeometry x="66" y="8" width="404" height="54" as="geometry" /></mxCell><mxCell id="v54" value="&lt;b&gt;pool system&lt;/b&gt; 2× e2-medium&lt;br&gt;&lt;b&gt;pool apps&lt;/b&gt; 3× n2-standard-2 (1 por zona)&lt;br&gt;agendado 07:00–23:30 seg–sex (America/Sao_Paulo)&lt;br&gt;Dataplane V2 (eBPF) — &lt;b&gt;SCTP habilitado&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=10;strokeColor=#B0B0B0;fillColor=#F7F7F7;strokeWidth=1.5;spacingTop=2;" vertex="1" parent="v51"><mxGeometry x="12" y="70" width="452" height="104" as="geometry" /></mxCell><mxCell id="v55" value="&lt;b&gt;namespace plataforma-Empresa&lt;/b&gt; (ArgoCD, sync waves −1…8)&lt;br&gt;• &lt;b&gt;dra&lt;/b&gt; ×2 (SCTP :3868 ext · :3869 headless) · &lt;b&gt;ro-server&lt;/b&gt; · &lt;b&gt;sy-server&lt;/b&gt;&lt;br&gt;• núcleo gRPC: &lt;b&gt;session&lt;/b&gt; :50053 · balance · catalog · subscriber · policy (stub)&lt;br&gt;• &lt;b&gt;api-gateway&lt;/b&gt; REST :8080 · &lt;b&gt;plataforma&lt;/b&gt; (portal) · &lt;b&gt;tmf-api&lt;/b&gt; · &lt;b&gt;config-server&lt;/b&gt; (SQLite, PVC 5 Gi)&lt;br&gt;• &lt;b&gt;migrate&lt;/b&gt; (Job PreSync) · db-secrets&lt;br&gt;&lt;b&gt;namespace kafka&lt;/b&gt;: Strimzi 1.0.1 · Kafka 4.1.2 KRaft ×3 (TLS+SCRAM :9096)&lt;br&gt;&lt;i&gt;desligados: rating (m12), Empresa-scf, Empresa-inap, Empresa-voice-diameter&lt;/i&gt;&lt;br&gt;&lt;b&gt;Exposição SCTP&lt;/b&gt;: NodePort/hostPort em nós com IP interno fixo, via VPN/Interconnect — os LBs do GCP não balanceiam SCTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v51"><mxGeometry x="12" y="180" width="452" height="214" as="geometry" /></mxCell><mxCell id="v56" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#4285F4;fillColor=#FFFFFF;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;fontStyle=1;" vertex="1" parent="v45"><mxGeometry x="1004" y="40" width="476" height="400" as="geometry" /></mxCell><mxCell id="v57" value="" style="sketch=0;html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=11;fontColor=#424242;shape=mxgraph.gcp2.hexIcon;prIcon=container_engine;" vertex="1" parent="1"><mxGeometry x="1356" y="536" width="46" height="40" as="geometry" /></mxCell><mxCell id="v58" value="&lt;b&gt;gke-plataforma-data&lt;/b&gt;&lt;br&gt;GKE Standard 1.35 · analytics" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=12;" vertex="1" parent="v56"><mxGeometry x="66" y="8" width="404" height="54" as="geometry" /></mxCell><mxCell id="v59" value="&lt;b&gt;pool apps&lt;/b&gt; 3× e2-medium (ou e2-standard-2)&lt;br&gt;agendado 07:00–23:30 seg–sex (America/Sao_Paulo)&lt;br&gt;PD balanced para os PVCs" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=10;strokeColor=#B0B0B0;fillColor=#F7F7F7;strokeWidth=1.5;spacin