;/b&gt; como proxy-cache do Docker Hub/quay/ghcr · proxy HTTP para os charts Helm&lt;br&gt;nós sem acesso direto à internet" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;" vertex="1" parent="v42"><mxGeometry x="66" y="30" width="508" height="88" as="geometry" /></mxCell><mxCell id="v45" value="Rede dos nós Kubernetes · Cilium (eBPF, NetworkPolicy, SCTP) · Rook-Ceph RBD para PVCs" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#7F6000;fillColor=#F3F3F3;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;fontStyle=1;" vertex="1" parent="v29"><mxGeometry x="20" y="168" width="2000" height="696" as="geometry" /></mxCell><mxCell id="v46" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#D86613;fillColor=#FFFFFF;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;fontStyle=1;" vertex="1" parent="v45"><mxGeometry x="20" y="40" width="476" height="400" as="geometry" /></mxCell><mxCell id="v47" value="" style="sketch=0;html=1;dashed=0;whiteSpace=wrap;fillColor=#2875E2;strokeColor=#ffffff;shape=mxgraph.kubernetes.icon;prIcon=master;" vertex="1" parent="1"><mxGeometry x="372" y="536" width="46" height="46" as="geometry" /></mxCell><mxCell id="v48" value="&lt;b&gt;k8s-cicd&lt;/b&gt; (RKE2 ou Talos)&lt;br&gt;hub do ArgoCD + plataforma" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=12;" vertex="1" parent="v46"><mxGeometry x="66" y="8" width="404" height="54" as="geometry" /></mxCell><mxCell id="v49" value="&lt;b&gt;3 control planes&lt;/b&gt; (VMs pequenas, etcd)&lt;br&gt;&lt;b&gt;2 workers&lt;/b&gt; 2 vCPU / 4 GB&lt;br&gt;24×7 (o hardware já está pago; desligar não economiza)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=10;strokeColor=#B0B0B0;fillColor=#F7F7F7;strokeWidth=1.5;spacingTop=2;" vertex="1" parent="v46"><mxGeometry x="12" y="70" width="452" height="104" as="geometry" /></mxCell><mxCell id="v50" value="&lt;b&gt;ArgoCD hub&lt;/b&gt; (mesmo chart)&lt;br&gt;• Harbor (registry + scan Trivy)&lt;br&gt;• Keycloak (OIDC para k8s, ArgoCD, Grafana)&lt;br&gt;• OpenBao/Vault + ESO (provider vault)&lt;br&gt;• runners self-hosted do GitHub Actions (opcional)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v46"><mxGeometry x="12" y="180" width="452" height="214" as="geometry" /></mxCell><mxCell id="v51" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#333333;fillColor=#FFFFFF;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;fontStyle=1;" vertex="1" parent="v45"><mxGeometry x="512" y="40" width="476" height="400" as="geometry" /></mxCell><mxCell id="v52" value="" style="sketch=0;html=1;dashed=0;whiteSpace=wrap;fillColor=#2875E2;strokeColor=#ffffff;shape=mxgraph.kubernetes.icon;prIcon=master;" vertex="1" parent="1"><mxGeometry x="864" y="536" width="46" height="46" as="geometry" /></mxCell><mxCell id="v53" value="&lt;b&gt;k8s-workload&lt;/b&gt; (RKE2 ou Talos)&lt;br&gt;charging · 3 masters + workers" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=12;" vertex="1" parent="v51"><mxGeometry x="66" y="8" width="404" height="54" as="geometry" /></mxCell><mxCell id="v54" value="&lt;b&gt;workers apps&lt;/b&gt; 3× 4 vCPU / 16 GB (1 por host)&lt;br&gt;&lt;b&gt;workers system&lt;/b&gt; 2× 2 vCPU / 4 GB&lt;br&gt;anti-affinity por host físico&lt;br&gt;Multus/SR-IOV opcional para a interface Diameter" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=10;strokeColor=#B0B0B0;fillColor=#F7F7F7;strokeWidth=1.5;spacingTop=2;" vertex="1" parent="v51"><mxGeometry x="12" y="70" width="452" height="104" as="geometry" /></mxCell><mxCell id="v55" value="&lt;b&gt;namespace plataforma-Empresa&lt;/b&gt; (ArgoCD, sync waves −1…8)&lt;br&gt;• &lt;b&gt;dra&lt;/b&gt; ×2 (SCTP :3868 ext · :3869 headless) · &lt;b&gt;ro-server&lt;/b&gt; · &lt;b&gt;sy-server&lt;/b&gt;&lt;br&gt;• núcleo gRPC: &lt;b&gt;session&lt;/b&gt; :50053 · balance · catalog · subscriber · policy (stub)&lt;br&gt;• &lt;b&gt;api-gateway&lt;/b&gt; REST :8080 · &lt;b&gt;plataforma&lt;/b&gt; (portal) · &lt;b&gt;tmf-api&lt;/b&gt; · &lt;b&gt;config-server&lt;/b&gt; (SQLite, PVC 5 Gi)&lt;br&gt;• &lt;b&gt;migrate&lt;/b&gt; (Job PreSync) · db-secrets&lt;br&gt;&lt;b&gt;namespace kafka&lt;/b&gt;: Strimzi 1.0.1 · Kafka 4.1.2 KRaft ×3 (TLS+SCRAM :9096)&lt;br&gt;&lt;i&gt;desligados: rating (m12), Empresa-scf, Empresa-inap, Empresa-voice-diameter&lt;/i&gt;&lt;br&gt;&lt;b&gt;SCTP nativo&lt;/b&gt;: Service LoadBalancer do MetalLB com IP anunciado por BGP à Empresa. Melhor caso dos quatro." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v51"><mxGeometry x="12" y="180" width="452" height="214" as="geometry" /></mxCell><mxCell id="v56" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#333333;fillColor=#FFFFFF;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;fontStyle=1;" vertex="1" parent="v45"><mxGeometry x="1004" y="40" width="476" height="400" as="geometry" /></mxCell><mxCell id="v57" value="" style="sketch=0;html=1;dashed=0;whiteSpace=wrap;fillColor=#2875E2;strokeColor=#ffffff;shape=mxgraph.kubernetes.icon;prIcon=master;" vertex="1" parent="1"><mxGeometry x="1356" y="536" width="46" height="46" as="geometry" /></mxCell><mxCell id="v58" value="&lt;b&gt;k8s-data&lt;/b&gt;&lt;br&gt;analytics" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=12;" ver