arent="v61"><mxGeometry x="12" y="70" width="452" height="104" as="geometry" /></mxCell><mxCell id="v65" value="&lt;b&gt;Mesma stack&lt;/b&gt; (agnóstica de nuvem)&lt;br&gt;• VictoriaMetrics · VictoriaLogs · Grafana · Jaeger&lt;br&gt;• Fluent Bit → Cloud Logging (≤50 GiB/mês gratuitos)&lt;br&gt;• opção: Managed Service for Prometheus + Cloud Trace" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v61"><mxGeometry x="12" y="180" width="452" height="214" as="geometry" /></mxCell><mxCell id="v66" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#9E9E9E;fillColor=#FFFFFF;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="v45"><mxGeometry x="20" y="466" width="384" height="212" as="geometry" /></mxCell><mxCell id="v67" value="" style="sketch=0;html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=11;fontColor=#424242;shape=mxgraph.gcp2.hexIcon;prIcon=cloud_iam;" vertex="1" parent="1"><mxGeometry x="372" y="966" width="46" height="40" as="geometry" /></mxCell><mxCell id="v68" value="&lt;b&gt;Sem bastion&lt;/b&gt;&lt;br&gt;IAP TCP forwarding + OS Login&lt;br&gt;kubectl via Connect Gateway&lt;br&gt;psql via Cloud SQL Auth Proxy&lt;br&gt;auditoria em Cloud Audit Logs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v66"><mxGeometry x="66" y="6" width="312" height="204" as="geometry" /></mxCell><mxCell id="v69" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#C925D1;fillColor=#FFFFFF;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="v45"><mxGeometry x="416" y="466" width="384" height="212" as="geometry" /></mxCell><mxCell id="v70" value="" style="sketch=0;html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=11;fontColor=#424242;shape=mxgraph.gcp2.hexIcon;prIcon=cloud_sql;" vertex="1" parent="1"><mxGeometry x="768" y="966" width="46" height="40" as="geometry" /></mxCell><mxCell id="v71" value="&lt;b&gt;Cloud SQL for PostgreSQL 16&lt;/b&gt;&lt;br&gt;Enterprise · 2 vCPU / 4 GB · zonal&lt;br&gt;SSD 50 GB (auto-increase) · CMEK&lt;br&gt;SSL obrigatório · PITR 7 d&lt;br&gt;IP privado (PSC) · IAM DB auth opcional&lt;br&gt;HA regional = 1 flag (produção)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v69"><mxGeometry x="66" y="6" width="312" height="204" as="geometry" /></mxCell><mxCell id="v72" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#C925D1;fillColor=#FFFFFF;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="v45"><mxGeometry x="812" y="466" width="384" height="212" as="geometry" /></mxCell><mxCell id="v73" value="" style="sketch=0;html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=11;fontColor=#424242;shape=mxgraph.gcp2.hexIcon;prIcon=cloud_memorystore;" vertex="1" parent="1"><mxGeometry x="1164" y="966" width="46" height="40" as="geometry" /></mxCell><mxCell id="v74" value="&lt;b&gt;Memorystore for Redis / Valkey&lt;/b&gt;&lt;br&gt;Basic 1 GB (staging)&lt;br&gt;Standard com réplica (produção)&lt;br&gt;AUTH + TLS em trânsito&lt;br&gt;acesso por PSC" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v72"><mxGeometry x="66" y="6" width="312" height="204" as="geometry" /></mxCell><mxCell id="v75" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#8C4FFF;fillColor=#FFFFFF;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;dashed=1;" vertex="1" parent="v45"><mxGeometry x="1208" y="466" width="384" height="212" as="geometry" /></mxCell><mxCell id="v76" value="" style="sketch=0;html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=11;fontColor=#424242;shape=mxgraph.gcp2.hexIcon;prIcon=cloud_pubsub;" vertex="1" parent="1"><mxGeometry x="1560" y="966" width="46" height="40" as="geometry" /></mxCell><mxCell id="v77" value="&lt;b&gt;Managed Service for Apache Kafka&lt;/b&gt;&lt;br&gt;equivalente ao MSK (desligado)&lt;br&gt;IAM/OAuth · 3 zonas&lt;br&gt;enquanto isso: Strimzi no GKE, igual ao de hoje" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v75"><mxGeometry x="66" y="6" width="312" height="204" as="geometry" /></mxCell><mxCell id="v78" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#9E9E9E;fillColor=#FFFFFF;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="v45"><mxGeometry x="1604" y="466" width="384" height="212" as="geometry" /></mxCell><mxCell id="v79" value="" style="sketch=0;html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=11;fontColor=#424242;shape=mxgraph.gcp2.hexIcon;prIcon=logging;" vertex="1" parent="1"><mxGeometry x="1956" y="966" width="46" height="40" as="geometry" /></mxCell><mxCell id="v80" value="&lt;b&gt;Cloud Monitoring / Logging&lt;/b&gt;&lt;br&gt;métricas de plataforma do GKE e do Cloud SQL&lt;br&gt;sem custo até a cota&lt;br&gt;alertas → Alertmanager / Grafana&lt;br&gt;(complementa, não substitui, o VictoriaMetrics)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v78"><mxGeometry x="66" y="6" width="312" height="204" as="geometry" /></mxCell><mxCell id="v81" value="" style="sketch=0;html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=11;fontColor=#424242;shape=mxgraph.gcp2.hexIcon;prIcon=cloud_vpn;" vertex="1" parent="1"><mxGeometry x="370" y="1296" width="56" height="49" as="geometry" /></mxCell><mxCell id="v82" value="&lt;b&gt;NCC + HA VPN&lt;/b&gt;&lt;br&gt;Cloud Router (BGP)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;spacing=2;" vertex="1" parent="1"><mxGeometry x="308.0" y="1349" width="180" height="110" as="geometry" /></mxCell><mxCell id="v83" value="Projeto plataforma-Empresa-dev · VPC dev 10.0.0.0/16" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#34A853;fillColor=none;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;fontStyle=1;" vertex="1" parent="v11"><mxGeometry x="220" y="1112" width="900" height="300" as="geometry" /></mxCell><mxCell id="v84" value="" style="sketch=0;html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=11;fontColor=#424242;shape=mxgraph.gcp2.hexIcon;prIcon=compute_engine;" vertex="1" parent="1"><mxGeometry x="550" y="1290" width="46" height="40" as="geometry" /></mxCell><mxCell id="v85" value="&lt;b&gt;GCE e2-medium&lt;/b&gt;&lt;br&gt;k3s (mesmo user-data)&lt;br&gt;IP externo estático&lt;br&gt;Artifact Registry sem timer de token (Workload Identity no node SA)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v83"><mxGeometry x="82" y="54" width="222" height="236" as="geometry" /></mxCell><mxCell id="v86" value="" style="sketch=0;html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=11;fontColor=#424242;shape=mxgraph.gcp2.hexIcon;prIcon=compute_engine;" vertex="1" parent="1"><mxGeometry x="842" y="1290" width="46" height="40" as="geometry" /></mxCell><mxCell id="v87" value="&lt;b&gt;GCE e2-standard-2&lt;/b&gt;&lt;br&gt;Pinot dev" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v83"><mxGeometry x="374" y="54" width="222" height="236" as="geometry" /></mxCell><mxCell id="v88" value="" style="sketch=0;html=1;fillColor=#5184F3;strokeColor=none;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;align=center;fontSize=11;fontColor=#424242;shape=mxgraph.gcp2.hexIcon;prIcon=cloud_router;" vertex="1" parent="1"><mxGeometry x="1134" y="1290" width="46" height="40" as="geometry" /></mxCell><mxCell id="v89" value="&lt;b&gt;Firewall da VPC&lt;/b&gt;&lt;br&gt;SCTP (proto 132) permitido por regra&lt;br&gt;a VPC é global: dev↔staging por peering ou Shared VPC, &lt;b&gt;sem TGW&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v83"><mxGeometry x="666" y="54" width="222" height="236" as="geometry" /></mxCell><mxCell id="v90" value="&lt;b&gt;O que muda em relação à AWS&lt;/b&gt;&lt;br&gt;• &lt;b&gt;IRSA → Workload Identity Federation for GKE&lt;/b&gt; (CA, ESO, Pinot, ArgoCD hub). Anotação &lt;i&gt;example.com/gcp-service-account&lt;/i&gt;.&lt;br&gt;• &lt;b&gt;AWS LBC → GKE Gateway API&lt;/b&gt;; as anotações &lt;i&gt;alb.ingress.kubernetes.io/*&lt;/i&gt; viram HTTPRoute/Gateway.&lt;br&gt;• &lt;b&gt;NAT ×3 + 15 endpoints → 1 Cloud NAT + Private Google Access&lt;/b&gt;: a maior economia estrutural.&lt;br&gt;• &lt;b&gt;Backend do Terraform&lt;/b&gt;: GCS com lock nativo (sem DynamoDB). Provider &lt;i&gt;google&lt;/i&gt; ~&gt; 6.x; a reescrita dos ~12 mil linhas de HCL é o maior custo de migração.&lt;br&gt;• &lt;b&gt;SCTP&lt;/b&gt;: suportado nos pods (Dataplane V2), não nos LBs. O padrão de hoje (NodePort + rede privada) continua valendo.&lt;br&gt;• &lt;b&gt;Latência até a Empresa&lt;/b&gt;: se o PCEF/PCRF continuar na AWS, cada CCR passa por VPN entre nuvens (+2 a 5 ms e jitter). Medir antes de decidir." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;strokeColor=#D6B656;fillColor=#FFF9E6;strokeWidth=1.5;spacingTop=6;spacingRight=8;" vertex="1" parent="v11"><mxGeometry x="1140" y="1112" width="920" height="300" as="geometry" /></mxCell><mxCell id="e91" value="push (Workload Identity Federation)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;fontColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="v4" target="v13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e92" value="IAP · Connect Gateway" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;fontColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.55;" edge="1" parent="1" source="v6" target="v29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e93" value="saída 0.0.0.0/0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;fontColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v30" target="v2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e94" value="Diameter Ro/Gy/Sy (SCTP)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;fontColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="v8" target="v81"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e95" value="peering