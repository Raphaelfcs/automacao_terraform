tex="1" parent="v29"><mxGeometry x="20" y="168" width="2000" height="696" as="geometry" /></mxCell><mxCell id="v46" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#D86613;fillColor=#FFFFFF;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;fontStyle=1;" vertex="1" parent="v45"><mxGeometry x="20" y="40" width="476" height="400" as="geometry" /></mxCell><mxCell id="v47" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/containers/Kubernetes_Services.svg;" vertex="1" parent="1"><mxGeometry x="372" y="536" width="46" height="46" as="geometry" /></mxCell><mxCell id="v48" value="&lt;b&gt;aks-plataforma-cicd&lt;/b&gt;&lt;br&gt;AKS 1.35 · privado · hub do ArgoCD" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=12;" vertex="1" parent="v46"><mxGeometry x="66" y="8" width="404" height="54" as="geometry" /></mxCell><mxCell id="v49" value="&lt;b&gt;system pool&lt;/b&gt; 1× B2s (CriticalAddonsOnly)&lt;br&gt;&lt;b&gt;user pool&lt;/b&gt; 2× B2s&lt;br&gt;agendado 07:00–23:30 seg–sex (America/Sao_Paulo) (az aks nodepool scale / KEDA cron)&lt;br&gt;Tier Free em staging · Standard (SLA) em produção" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=10;strokeColor=#B0B0B0;fillColor=#F7F7F7;strokeWidth=1.5;spacingTop=2;" vertex="1" parent="v46"><mxGeometry x="12" y="70" width="452" height="104" as="geometry" /></mxCell><mxCell id="v50" value="&lt;b&gt;ArgoCD hub&lt;/b&gt; (mesmo chart)&lt;br&gt;• destinos com &lt;b&gt;Entra Workload ID&lt;/b&gt; + RBAC do AKS (kubelogin)&lt;br&gt;• alternativa nativa: extensão Flux (GitOps), troca de ferramenta&lt;br&gt;Cluster Autoscaler nativo · ESO com provider Azure Key Vault" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v46"><mxGeometry x="12" y="180" width="452" height="214" as="geometry" /></mxCell><mxCell id="v51" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#0078D4;fillColor=#FFFFFF;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;fontStyle=1;" vertex="1" parent="v45"><mxGeometry x="512" y="40" width="476" height="400" as="geometry" /></mxCell><mxCell id="v52" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/containers/Kubernetes_Services.svg;" vertex="1" parent="1"><mxGeometry x="864" y="536" width="46" height="46" as="geometry" /></mxCell><mxCell id="v53" value="&lt;b&gt;aks-plataforma-workload&lt;/b&gt;&lt;br&gt;AKS 1.35 · privado · charging" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=12;" vertex="1" parent="v51"><mxGeometry x="66" y="8" width="404" height="54" as="geometry" /></mxCell><mxCell id="v54" value="&lt;b&gt;system pool&lt;/b&gt; 2× B2s&lt;br&gt;&lt;b&gt;user pool&lt;/b&gt; 3× D2s_v5 (zonas 1–3)&lt;br&gt;agendado 07:00–23:30 seg–sex (America/Sao_Paulo)&lt;br&gt;Azure CNI Overlay + Cilium — &lt;b&gt;SCTP nos pods&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=10;strokeColor=#B0B0B0;fillColor=#F7F7F7;strokeWidth=1.5;spacingTop=2;" vertex="1" parent="v51"><mxGeometry x="12" y="70" width="452" height="104" as="geometry" /></mxCell><mxCell id="v55" value="&lt;b&gt;namespace plataforma-Empresa&lt;/b&gt; (ArgoCD, sync waves −1…8)&lt;br&gt;• &lt;b&gt;dra&lt;/b&gt; ×2 (SCTP :3868 ext · :3869 headless) · &lt;b&gt;ro-server&lt;/b&gt; · &lt;b&gt;sy-server&lt;/b&gt;&lt;br&gt;• núcleo gRPC: &lt;b&gt;session&lt;/b&gt; :50053 · balance · catalog · subscriber · policy (stub)&lt;br&gt;• &lt;b&gt;api-gateway&lt;/b&gt; REST :8080 · &lt;b&gt;plataforma&lt;/b&gt; (portal) · &lt;b&gt;tmf-api&lt;/b&gt; · &lt;b&gt;config-server&lt;/b&gt; (SQLite, PVC 5 Gi)&lt;br&gt;• &lt;b&gt;migrate&lt;/b&gt; (Job PreSync) · db-secrets&lt;br&gt;&lt;b&gt;namespace kafka&lt;/b&gt;: Strimzi 1.0.1 · Kafka 4.1.2 KRaft ×3 (TLS+SCRAM :9096)&lt;br&gt;&lt;i&gt;desligados: rating (m12), Empresa-scf, Empresa-inap, Empresa-voice-diameter&lt;/i&gt;&lt;br&gt;&lt;b&gt;Exposição SCTP&lt;/b&gt;: NodePort em nós com IP fixo via VPN/ExpressRoute — o Azure LB não balanceia SCTP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v51"><mxGeometry x="12" y="180" width="452" height="214" as="geometry" /></mxCell><mxCell id="v56" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#0078D4;fillColor=#FFFFFF;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;fontStyle=1;" vertex="1" parent="v45"><mxGeometry x="1004" y="40" width="476" height="400" as="geometry" /></mxCell><mxCell id="v57" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/containers/Kubernetes_Services.svg;" vertex="1" parent="1"><mxGeometry x="1356" y="536" width="46" height="46" as="geometry" /></mxCell><mxCell id="v58" value="&lt;b&gt;aks-plataforma-data&lt;/b&gt;&lt;br&gt;AKS 1.35 · analytics" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=12;" vertex="1" parent="v56"><mxGeometry x="66" y="8" width="404" height="54" as="geometry" /></mxCell><mxCell id="v59" value="&lt;b&gt;user pool&lt;/b&gt; 3× B2s (ou D2s_v5)&lt;br&gt;agendado 07:00–23:30 seg–sex (America/Sao_Paulo)&lt;br&gt;Managed Disks (Premium SSD v2) para os PVCs" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=10;strokeColor=#B0B0B0;fillColor=#F7F7F7;strokeWidth=1.5;spacingTop=2;" vertex="1" parent="v56"><mxGeometry x="12" y="70" width="452" height="104" as="geometry" /></mxCell><mxCell id="v60" value="&lt;b&gt;Apache Pinot&lt;/b&gt; igual ao atual&lt;br&gt;• deep store em &lt;b&gt;ADLS Gen2&lt;/b&gt; (plugin pinot-adls) via Workload ID&lt;br&gt;• ingestão REALTIME do Kafka&lt;br&gt;• opção gerenciada: Azure Data Explorer — &lt;i&gt;troca de produto&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v56"><mxGeometry x="12" y="180" width="452" height="214" as="geometry" /></mxCell><mxCell id="v61" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#E7157B;fillColor=#FFFFFF;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;fontStyle=1;" vertex="1" parent="v45"><mxGeometry x="1496" y="40" width="476" height="400" as="geometry" /></mxCell><mxCell id="v62" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/containers/Kubernetes_Services.svg;" vertex="1" parent="1"><mxGeometry x="1848" y="536" width="46" height="46" as="geometry" /></mxCell><mxCell id="v63" value="&lt;b&gt;aks-plataforma-monitoring&lt;/b&gt;&lt;br&gt;AKS 1.35" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=12;" vertex="1" parent="v61"><mxGeometry x="66" y="8" width="404" height="54" as="geometry" /></mxCell><mxCell id="v64" value="&lt;b&gt;system pool&lt;/b&gt; 1× B2s&lt;br&gt;&lt;b&gt;user pool&lt;/b&gt; 2× D2s_v5&lt;br&gt;agendado 07:00–23:30 seg–sex (America/Sao_Paulo)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=10;strokeColor=#B0B0B0;fillColor=#F7F7F7;strokeWidth=1.5;spacingTop=2;" vertex="1" parent="v61"><mxGeometry x="12" y="70" width="452" height="104" as="geometry" /></mxCell><mxCell id="v65" value="&lt;b&gt;Mesma stack&lt;/b&gt; (agnóstica de nuvem)&lt;br&gt;• VictoriaMetrics · VictoriaLogs · Grafana · Jaeger&lt;br&gt;• Fluent Bit → VictoriaLogs (evitar Log Analytics: ~US$ 3/GB)&lt;br&gt;• opção: Azure Monitor managed Prometheus + Managed Grafana" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v61"><mxGeometry x="12" y="180" width="452" height="214" as="geometry" /></mxCell><mxCell id="v66" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#9E9E9E;fillColor=#FFFFFF;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="v45"><mxGeometry x="20" y="466" width="384" height="212" as="geometry" /></mxCell><mxCell id="v67" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="1"><mxGeometry x="372" y="966" width="46" height="46" as="geometry" /></mxCell><mxCell id="v68" value="&lt;b&gt;Acesso administrativo&lt;/b&gt;&lt;br&gt;az aks command invoke (sem rede)&lt;br&gt;ou jump VM B1s + Entra ID SSH&lt;br&gt;Azure Bastion: ~US$ 140/mês, só se for exigido&lt;br&gt;auditoria: Activity Log + diagnostic settings" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v66"><mxGeometry x="66" y="6" width="312" height="204" as="geometry" /></mxCell><mxCell id="v69" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#C925D1;fillColor=#FFFFFF;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="v45"><mxGeometry x="416" y="466" width="384" height="212" as="geometry" /></mxCell><mxCell id="v70" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/databases/Azure_Database_PostgreSQL_Server.svg;" vertex="1" parent="1"><mxGeometry x="768" y="966" width="46" height="46" as="geometry" /></mxCell><mxCell id="v71" value="&lt;b&gt;Azure Database for PostgreSQL&lt;/b&gt;&lt;br&gt;Flexible Server 16 · Burstable B2s&lt;br&gt;64 GB · CMK no Key Vault&lt;br&gt;require_secure_transport=on · PITR 7 d&lt;br&gt;VNet integration (subnet delegada)&lt;br&gt;HA zone-redundant em produção" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v69"><mxGeometry x="66" y="6" width="312" height="204" as="geometry" /></mxCell><mxCell id="v72" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#C925D1;fillColor=#FFFFFF;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="v45"><mxGeometry x="812" y="466" width="384" height="212" as="geometry" /></mxCell><mxCell id="v73" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/databases/Cache_Redis.svg;" vertex="1" parent="1"><mxGeometry x="1164" y="966" width="46" height="46" as="geometry" /></mxCell><mxCell id="v74" value="&lt;b&gt;Azure Cache for Redis&lt;/b&gt;&lt;br&gt;Basic C0 (staging) → Standard C1 (produção)&lt;br&gt;ou Azure Managed Redis&lt;br&gt;TLS 1.2 + access key / Entra auth&lt;br&gt;Private Endpoint" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v72"><mxGeometry x="66" y="6" width="312" height="204" as="geometry" /></mxCell><mxCell id="v75" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#8C4FFF;fillColor=#FFFFFF;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;dashed=1;" vertex="1" parent="v45"><mxGeometry x="1208" y="466" width="384" height="212" as="geometry" /></mxCell><mxCell id="v76" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/analytics/Event_Hubs.svg;" vertex="1" parent="1"><mxGeometry x="1560" y="966" width="46" height="46" as="geometry" /></mxCell><mxCell id="v77" value="&lt;b&gt;Event Hubs (endpoint Kafka)&lt;/b&gt;&lt;br&gt;Premium para paridade com o MSK&lt;br&gt;⚠ protocolo Kafka parcial: validar&lt;br&gt;transações e compaction com o franz-go&lt;br&gt;alternativa: Strimzi no AKS (igual ao de hoje)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v75"><mxGeometry x="66" y="6" width="312" height="204" as="geometry" /></mxCell><mxCell id="v78" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#9E9E9E;fillColor=#FFFFFF;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="v45"><mxGeometry x="1604" y="466" width="384" height="212" as="geometry" /></mxCell><mxCell id="v79" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/management_governance/Monitor.svg;" vertex="1" parent="1"><mxGeometry x="1956" y="966" width="46" height="46" as="geometry" /></mxCell><mxCell id="v80" value="&lt;b&gt;Azure Monitor&lt;/b&gt;&lt;br&gt;Container insights (opcional)&lt;br&gt;métricas de plataforma gratuitas&lt;br&gt;alertas de PaaS (PostgreSQL, Redis)&lt;br&gt;(complementa o VictoriaMetrics)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v78"><mxGeometry x="66" y="6" width="312" height="204" as="geometry" /></mxCell><mxCell id="v81" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/networking/Virtual_WANs.svg;" vertex="1" parent="1"><mxGeometry x="370" y="1296" width="56" height="56" as="geometry" /></mxCell><mxCell id="v82" value="&lt;b&gt;Hub VNet / vWAN&lt;/b&gt;&lt;br&gt;VPN Gateway (BGP)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;spacing=2;" vertex="1" parent="1"><mxGeometry x="308.0" y="1356" width="180" height="110" as="geometry" /></mxCell><mxCell id="v83" value="Assinatura/RG dev · VNet dev 10.0.0.0/16 (spoke)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#50E6FF;fillColor=none;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;fontStyle=1;" vertex="1" parent="v11"><mxGeometry x="220" y="1112" width="900" height="300" as="geometry" /></mxCell><mxCell id="v84" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="1"><mxGeometry x="550" y="1290" width="46" height="46" as="geometry" /></mxCell><mxCell id="v85" value="&lt;b&gt;VM B2s&lt;/b&gt;&lt;br&gt;k3s (cloud-init)&lt;br&gt;IP público Standard&lt;br&gt;pull do ACR com managed identity (sem timer de token)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v83"><mxGeometry x="82" y="54" width="222" height="236" as="geometry" /></mxCell><mxCell id="v86" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="1"><mxGeometry x="842" y="1290" width="46" height="46" as="geometry" /></mxCell><mxCell id="v87" value="&lt;b&gt;VM B2ms&lt;/b&gt;&lt;br&gt;Pinot dev" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v83"><mxGeometry x="374" y="54" width="222" height="236" as="geometry" /></mxCell><mxCell id="v88" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/networking/Public_IP_Addresses.svg;" vertex="1" parent="1"><mxGeometry x="1134" y="1290" width="46" height="46" as="geometry" /></mxCell><mxCell id="v89" value="&lt;b&gt;NSG&lt;/b&gt;&lt;br&gt;SCTP liberado por regra (protocolo *)&lt;br&gt;peering dev↔hub↔staging&lt;br&gt;rotas UDR para a Empresa" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=2;fontSize=10;" vertex="1" parent="v83"><mxGeometry x="666" y="54" width="222" height="236" as="geometry" /></mxCell><mxCell id="v90" value="&lt;b&gt;O que muda em relação à AWS&lt;/b&gt;&lt;br&gt;• &lt;b&gt;IRSA → Microsoft Entra Workload ID&lt;/b&gt; (federated credentials por service account).&lt;br&gt;• &lt;b&gt;Secrets Manager + KMS → Key Vault&lt;/b&gt; (segredos e chaves no mesmo serviço; ESO tem provider nativo).&lt;br&gt;• &lt;b&gt;Control plane&lt;/b&gt;: tier Free (sem SLA) atende staging sem custo; produção precisa do Standard (US$ 0,10/h, igual ao EKS).&lt;br&gt;• &lt;b&gt;Backend do Terraform&lt;/b&gt;: Storage Account com lease lock; provider azurerm ~&gt; 4.x; reescrita completa do HCL.&lt;br&gt;• &lt;b&gt;Kafka&lt;/b&gt;: o Event Hubs não é Kafka; pode quebrar features que o franz-go usa. O caminho de menor risco é manter o Strimzi.&lt;br&gt;• &lt;b&gt;Custos escondidos&lt;/b&gt;: Log Analytics (~US$ 3/GB), Azure Bastion, Azure Firewall e App Gateway. Todos opcionais neste desenho." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;strokeColor=#D6B656;fillColor=#FFF9E6;strokeWidth=1.5;spacingTop=6;spacingRight=8;" vertex="1" parent="v11"><mxGeometry x="1140" y="1112" width="920" height="300" as="geometry" /></mxCell><mxCell id="e91" value="push (OIDC → Entra federated credential)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;fontColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="v4" target="v13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e92" value="Entra ID · command invoke" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;fontColor=#333333;strokeWidth=1.5;endArrow=block;end