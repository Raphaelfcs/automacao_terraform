ashPattern=6 4;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="n_db" target="n_sla"><mxGeometry relative="1" as="geometry"><mxPoint x="1364" y="154.0" as="sourcePoint"/><mxPoint x="1400" y="336.0" as="targetPoint"/><Array as="points"><mxPoint x="1384.0" y="154.0"/><mxPoint x="1384.0" y="336.0"/></Array></mxGeometry></mxCell><mxCell id="b1_155" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="155" y="134.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b2_359" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="359" y="134.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b3_567" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="567" y="152.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b4_735" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="735" y="152.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b5_923" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="923" y="152.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b6_1203" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1203" y="134.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="tit" value="&lt;b&gt;VM provisioning: current process&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#545B64&quot;&gt;Five queues and a war room to deliver one VM&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1424" height="56" as="geometry"/></mxCell><mxCell id="leg" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#8C99A6;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="1424" height="164" as="geometry"/></mxCell><mxCell id="legt" value="&lt;b&gt;Flow&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="34" y="488" width="300" height="20" as="geometry"/></mxCell><mxCell id="lega" value="&lt;b&gt;1.&lt;/b&gt; The request arrives in a spreadsheet with 20+ fields.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; DNS ticket to define the hostname.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; IP looked up by hand in Azure and IPAM.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="510" width="692.0" height="57" as="geometry"/></mxCell><mxCell id="legb" value="&lt;b&gt;4.&lt;/b&gt; Firewall rule and NAT through another queue.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; An infrastructure war room creates the VM by script.&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; DBA installs the IaaS database and the SLA is missed.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="738.0" y="510" width="692.0" height="57" as="geometry"/></mxCell><mxCell id="legn" value="• Each queue waits for the previous one: weeks for a simple VM.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="565" width="1384" height="23" as="geometry"/></mxCell><mxCell id="k0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="34" y="619" as="sourcePoint"/><mxPoint x="74" y="619" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt0" value="Main flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="82" y="609" width="200" height="20" as="geometry"/></mxCell><mxCell id="k1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="284" y="619" as="sourcePoint"/><mxPoint x="324" y="619" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt1" value="Support, backup or alternative" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="332" y="609" width="200" height="20" as="geometry"/></mxCell><mxCell id="k2" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="545" y="610" width="18" height="18" as="geometry"/></mxCell><mxCell id="kt2" value="Flow step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="582" y="609" width="200" height="20" as="geometry"/></mxCell><mxCell id="k3" value="" style="rounded=1;arcSize=8;html=1;fillColor=none;strokeColor=#0078D4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="784" y="610" width="40" height="18" as="geometry"/></mxCell><mxCell id="kt3" value="Azure subscription / VNet" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="832" y="609" width="200" height="20" as="geometry"/></mxCell></