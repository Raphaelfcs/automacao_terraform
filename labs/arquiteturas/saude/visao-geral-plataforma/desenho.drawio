FF;dashed=1;dashPattern=6 4;exitX=1.000;exitY=0.875;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.000;entryY=0.875;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="n_s31" target="n_s32"><mxGeometry relative="1" as="geometry"><mxPoint x="1056" y="252.0" as="sourcePoint"/><mxPoint x="1056" y="488.0" as="targetPoint"/><Array as="points"><mxPoint x="1143.0" y="252.0"/><mxPoint x="1143.0" y="488.0"/></Array></mxGeometry></mxCell><mxCell id="b1_175" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="175" y="214.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b2_343" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="343" y="214.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b3_611" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="611" y="196.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b4_835" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="835" y="214.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b5_1063" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1063" y="196.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b6_1083" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1083" y="232.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="tit" value="&lt;b&gt;Multi-region backup with shared network&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#545B64&quot;&gt;Health insurer · AWS&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1374" height="56" as="geometry"/></mxCell><mxCell id="leg" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#8C99A6;" vertex="1" parent="1"><mxGeometry x="20" y="630" width="1374" height="164" as="geometry"/></mxCell><mxCell id="legt" value="&lt;b&gt;Flow&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="34" y="638" width="300" height="20" as="geometry"/></mxCell><mxCell id="lega" value="&lt;b&gt;1.&lt;/b&gt; Backup agents run next to workloads, in Auto Scaling.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Backup traffic goes through the network account Transit Gateway (TCP 8400-8410).&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Active orchestrator in us-east-1, passive in sa-east-1.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="660" width="667.0" height="57" as="geometry"/></mxCell><mxCell id="legb" value="&lt;b&gt;4.&lt;/b&gt; Writes to S3 IA through a VPC endpoint, no internet.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Lifecycle moves old copies to Glacier Deep Archive.&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; Cross-region replica for DR.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="713.0" y="660" width="667.0" height="57" as="geometry"/></mxCell><mxCell id="legn" value="• Separate application, network and backup accounts reduce blast radius.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;whi