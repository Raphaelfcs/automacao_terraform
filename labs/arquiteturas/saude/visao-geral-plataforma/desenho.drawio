="611" y="196.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b4_835" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="835" y="214.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b5_1063" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1063" y="196.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b6_1083" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1083" y="232.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="tit" value="&lt;b&gt;Backup multi-região com rede compartilhada&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#545B64&quot;&gt;Operadora de saúde · AWS&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1374" height="56" as="geometry"/></mxCell><mxCell id="leg" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#8C99A6;" vertex="1" parent="1"><mxGeometry x="20" y="630" width="1374" height="164" as="geometry"/></mxCell><mxCell id="legt" value="&lt;b&gt;Jornada&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="34" y="638" width="300" height="20" as="geometry"/></mxCell><mxCell id="lega" value="&lt;b&gt;1.&lt;/b&gt; Agentes de backup rodam junto das cargas, em Auto Scaling.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Tráfego de backup passa pelo Transit Gateway da conta de rede (TCP 8400-8410).&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Orquestrador ativo em us-east-1, passivo em sa-east-1.&l