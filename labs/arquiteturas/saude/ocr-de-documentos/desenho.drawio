8" height="18" as="geometry"/></mxCell><mxCell id="tit" value="&lt;b&gt;Document OCR at scale&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#545B64&quot;&gt;Extraction, validation and results via API&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1352" height="56" as="geometry"/></mxCell><mxCell id="leg" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#8C99A6;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="1352" height="181" as="geometry"/></mxCell><mxCell id="legt" value="&lt;b&gt;Flow&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="34" y="628" width="300" height="20" as="geometry"/></mxCell><mxCell id="lega" value="&lt;b&gt;1.&lt;/b&gt; Document enters through the API.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Lambda stores it in S3.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Textract processes asynchronously.&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; SNS signals when the job is done.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="650" width="656.0" height="74" as="geometry"/></mxCell><mxCell id="legb" value="&lt;b&gt;5.&lt;/b&gt; Lambdas extract fields and classify the type.&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; Textual, visual and structural validations.&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; Result in DynamoDB, exposed via API.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="702.0" y="650" width="656.0" height="57" as="geometry"/></mxCell><mxCell id="legn" value="• Errors go to their own topic with reprocessing; environments in separate accounts.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;whiteSpa