        </mxCell>
        <mxCell id="5hBLYqIW2fzxgn4p7Xpf-35" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;RDS MULTAZ" style="outlineConnect=0;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;shape=mxgraph.aws4.resourceIcon;fillColor=#C925D1;gradientColor=none;sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];fontColor=#232F3E;strokeColor=#ffffff;fontStyle=0;aspect=fixed;resIcon=mxgraph.aws4.rds;" parent="5hBLYqIW2fzxgn4p7Xpf-38" vertex="1">
