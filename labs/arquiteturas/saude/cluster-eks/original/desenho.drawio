        <mxCell id="5hBLYqIW2fzxgn4p7Xpf-39" value="Camada de dados, se ater somente as regras de grupo de segurança para que o novo cluster se comunique por camada de rede, sobre permissões de usuários: Os mesmos já estão com permissão em tabelas, mas uma boa prática seria vincular contas de serviço IAM com ROles para acessar tabelas e bancos específicos" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[1,1,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];rounded=1;absoluteArcSize=1;arcSize=2;html=1;strokeColor=none;gradientColor=none;shadow=0;dashed=0;fontSize=12;fontColor=#9E9E9E;align=left;verticalAlign=top;spacing=10;spacingTop=-4;whiteSpace=wrap;fillColor=#F1F8E9;" parent="1" vertex="1">
