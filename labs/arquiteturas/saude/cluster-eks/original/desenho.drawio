        <mxCell id="5hBLYqIW2fzxgn4p7Xpf-20" value="Camda de FrontEnd&lt;br&gt;&lt;br&gt;Nossa aplicação será entregue dentro de um S3, o Cloudfront ou nossa CDN vai distribuir esse S3 de modo seguro, em PRD usaremos o WAF para requisiçõe" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[1,1,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];rounded=1;absoluteArcSize=1;arcSize=2;html=1;strokeColor=none;gradientColor=none;shadow=0;dashed=0;fontSize=12;fontColor=#9E9E9E;align=left;verticalAlign=top;spacing=10;spacingTop=-4;whiteSpace=wrap;fillColor=#F1F8E9;" parent="1" vertex="1">
