        <mxCell id="urWBHsYXLG8RKWuSx1Yd-67" value="PIPELINE AWS BATCH JOBS" style="fillColor=none;strokeColor=#B266FF;dashed=1;verticalAlign=top;fontStyle=0;fontColor=#5A6C86;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
