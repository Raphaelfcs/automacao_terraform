<mxfile host="drawio" type="device"><diagram id="p0" name="Google Cloud — árvore de recursos e permissões"><mxGraphModel dx="1200" dy="612" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="652" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c3" value="&lt;b style=&quot;font-size:14px&quot;&gt;Organização example.com&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5F6368&quot;&gt;Cloud Identity · usuários e grupos vindos do Entra ID (SAML + SCIM)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;strokeWidth=1.6;align=left;spacingLeft=52;fontSize=11;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="430.0" y="30.0" width="340.0" height="58.0" as="geometry" /></mxCell><mxCell id="c4" value="" style="shape=image;html=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="440" y="41" width="34" height="34" as="geometry" /></mxCell><mxCell id="c5" value="&lt;b&gt;Org Policies na raiz (herdadas por tudo)&lt;/b&gt;&lt;br&gt;• resourceLocations → só southamerica-east1&lt;br&gt;• allowedPolicyMemberDomains → só example.com&lt;br&gt;• disableServiceAccountKeyCreation · sem grants automáticos&lt;br&gt;• vmExternalIpAccess negado · requireOsLogin · sem rede default&lt;br&gt;• publicAccessPrevention · uniformBucketLevelAccess · restrictPublicIp" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F7F9;strokeColor=#8C99A6;dashed=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="14.0" y="24.0" width="400.0" height="98.0" as="geometry" /></mxCell><mxCell id="c6" value="&lt;b&gt;IAM na raiz (grupos, nunca usuários)&lt;/b&gt;&lt;br&gt;• grp-gcp-org-admins → Organization Admin (2 pessoas + break-glass)&lt;br&gt;• grp-gcp-billing-admins → Billing Account Administrator&lt;br&gt;• grp-gcp-security-admins → Security Center Admin · Org Policy Admin&lt;br&gt;• grp-gcp-auditors → Security Reviewer · Private Logs Viewer&lt;br&gt;• IAM Deny: ninguém exclui o sink de logs nem a pasta common" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F7F9;strokeColor=#8C99A6;dashed=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="786.0" y="24.0" width="400.0" height="98.0" as="geometry" /></mxCell><mxCell id="c7" value="📁 fldr-bootstrap" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F4F7F9;strokeColor=#8C99A6;dashed=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;fontStyle=1;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="14.0" y="156.0" width="160.6" height="416.0" as="geometry" /></mxCell><mxCell id="c8" value="&lt;b style=&quot;font-size:10.5px&quot;&gt;prj-b-seed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5F6368&quot;&gt;estado do Terraform · SA de deploy&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BDC1C6;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="20.0" y="186.0" width="148.6" height="44.0" as="geometry" /></mxCell><mxCell id="c9" value="&lt;b style=&quot;font-size:10.5px&quot;&gt;prj-b-cicd&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5F6368&quot;&gt;Workload Identity Federation (GitHub)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BDC1C6;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="20.0" y="236.0" width="148.6" height="44.0" as="geometry" /></mxCell><mxCell id="c10" value="&lt;b style=&quot;color:#007F85&quot;&gt;IAM na pasta&lt;/b&gt;&lt;br&gt;Só as SAs de pipeline. Humanos: nenhum acesso." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F4F1;strokeColor=#007F85;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontColor=#202