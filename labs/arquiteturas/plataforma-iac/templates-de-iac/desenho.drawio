        <mxCell id="0jbEnOfrFWWEFlrw_YXw-5" value="&lt;ul&gt;&lt;li&gt;&lt;b&gt;Name pattern&lt;/b&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;&quot; data-font-src=&quot;https://fonts.googleapis.com/css?family=Noto+Sans+Mono&quot; face=&quot;Noto Sans Mono&quot;&gt;&amp;lt;acronym&amp;gt;-&amp;lt;type&amp;gt;-&amp;lt;project_name&amp;gt;-&amp;lt;technology&amp;gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;Examples:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;eve-template-workflow-java&lt;/li&gt;&lt;li&gt;eve-template-ec2-terraform&lt;/li&gt;&lt;li&gt;eve-template-backend-java&lt;/li&gt;&lt;li&gt;eve-template-frontend-angular&lt;/li&gt;&lt;li&gt;eve-backend-sistema_abc-java&lt;/li&gt;&lt;li&gt;eve-frontend-sistema_abc-angular&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;li&gt;&lt;b&gt;Layout&lt;/b&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;u&gt;Mono (*Por sistema)&lt;/u&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Less operational overhead&lt;/li&gt;&lt;li&gt;Better control over the changes&lt;/li&gt;&lt;li&gt;Better for IaC, Schemas &amp;amp; API Contracts, Documentation-as-Code, Database migrations&lt;/li&gt;&lt;li&gt;&lt;b&gt;Structure&lt;/b&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Noto+Sans+Mono&quot; face=&quot;Noto Sans Mono&quot;&gt;&amp;lt;tenant&amp;gt;&lt;/font&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Noto+Sans+Mono&quot; face=&quot;Noto Sans Mono&quot;&gt;&amp;lt;system&amp;gt;&lt;/font&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Noto+Sans+Mono&quot; face=&quot;Noto Sans Mono&quot;&gt;&amp;lt;resource&amp;gt;&lt;/font&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;font face=&quot;KTCDsExkB4RzFU-0TH6x&quot;&gt;...&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;li&gt;&lt;u&gt;Multi&lt;/u&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Better for Workloads&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;li&gt;&lt;b&gt;Part of IaC within Workloads Repository&lt;/b&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Developers have limited power to adjust the configurations&lt;/li&gt;&lt;li&gt;Need guardrails to avoid drifts and unauthorized changes&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;&lt;b&gt;Default Repositories&lt;/b&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;u&gt;Catalog&lt;/u&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Monorepo w/ initial catalog entries, syncs, existing assets, groups, meta-users, Tenant, Domain, System, etc.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;&lt;u&gt;API Contracts&lt;/u&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Monorepo for api contracts, schemas, etc. Avro, JSON Schema, Protobuf, OpenAPI, AsyncAPI, etc.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;&lt;u&gt;Templates&lt;/u&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Multirepo, each one hosting unique template.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;&lt;u&gt;Techdoc&lt;/u&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Monorepo for documentation-as-code with Markdown&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;&lt;u&gt;AWS Terraform&lt;/u&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Monorepo hosting terraform for AWS accounts&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;&lt;u&gt;c8s-workloads&lt;/u&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Monorepo with container workloads deployment enablement&lt;/li&gt;&lt;li&gt;&lt;i&gt;* the container workload configuration lives in the application repository&lt;/i&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;&lt;u&gt;c8s-clusters&lt;/u&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Monorepo with container clusters configuration&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;&lt;u&gt;Containers&lt;/u&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Monorepo with ready-made container files for company's technology stacks&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;&lt;u&gt;plataforma CI&lt;/u&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Reusable CI tasks written with Taskfile&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;&lt;u&gt;Support&lt;/u&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Reusable scripts, static configurations, etc, to support the CI pipelines&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;&lt;u&gt;Backstage&lt;/u&gt;:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Monorepo with IDP backend and frontend&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;&lt;u&gt;Examples&lt;/u&gt;:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Multirepo, each one hosting a fully functional example of company's technology stack&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=Noto Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DNoto%2BSans;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="160" y="210" width="480" height="870" as="geometry" />
        </mxCell>
        <mxCell id="6T3wUOR754ufZLEEPFTO-1" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;ul style=&quot;&quot;&gt;&lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Branch Management&lt;/span&gt;&lt;/li&gt;&lt;ul style=&quot;&quot;&gt;&lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;u&gt;Gitflow&lt;/u&gt;&lt;/span&gt;&lt;/li&gt;&lt;ul style=&quot;font-size: 12px;&quot;&gt;&lt;li&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;Develop, Release, Main&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;Feature, Fix, Hotfix&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;Trunk-based (*Infra, detalhar)&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Branch-environment Linking&lt;/span&gt;&lt;/li&gt;&lt;ul style=&quot;font-size: 12px;&quot;&gt;&lt;li&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;Develop to DEV&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;Release to QA (*HInt)&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;HExt (* Controlado)&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;Tag from Main to PRD (*Existe tb o ambiente Hom Externa), *Controlado&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Package Promotion &lt;span style=&quot;font-weight: normal;&quot;&gt;(*Este - hoje)&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;ul style=&quot;font-size: 12px;&quot;&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&lt;u&gt;No branch-environment link&lt;/u&gt;&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;Everything starts with Release Candidate package&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;Release Candidate package to DEV&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;Then, to QA&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;And ultimately, to PRD&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/h1&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontFamily=Noto Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DNoto%2BSans;fontSize=12;fontColor=#333333;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="680" y="210" width="400" height="350" as="geometry" />
        </mxCell>
