#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="359" y="158.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b3_533" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="533" y="176.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b4_901" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="901" y="176.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b5_533" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="533" y="316.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="tit" value="&lt;b&gt;Template workflow: multi-repo vs monorepo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#545B64&quot;&gt;Application and infrastructure together or apart&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1178" height="56" as="geometry"/></mxCell><mxCell id="leg" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#8C99A6;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="1178" height="164" as="geometry"/></mxCell><mxCell id="legt" value="&lt;b&gt;Flow&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="34" y="488" width="300" height="20" as="geometry"/></mxCell><mxCell id="lega" value="&lt;b&gt;1.&lt;/b&gt; Developer picks the template.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Portal creates the repositories.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; CI builds and pushes the image.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="510" width="569.0" height="57" as="geometry"/></mxCell><mxCell id="legb" value="&lt;b&gt;4.&lt;/b&gt; CD deploys to ECS.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Separate infra, applied by Atlantis.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="615.0" y="510" width="569.0" height="40" as="geometry"/></mxCell><mxCell id="legn" value="• In the monorepo, app and terraform/ live in one repository with separate pipelines.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="565" width="1138" height="23" as="geometry"/></mxCell><mxCell id="k0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="34" y="619" as="sourcePoint"/><mxPoint x="74" y="619" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt0" value="Main flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="82" y="609" width="200" height="20" as="geometry"/></mxCell><mxCell id="k1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="284" y="619" as="sourcePoint"/><mxPoint x="324" y="619" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt1" value="Support, backup or alternative" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="332" y="609" width="200" height="20" as="geometry"/></mxCell><mxCell id="k2" value="1" style="ellipse;html=1;aspect=fixed;fillCol