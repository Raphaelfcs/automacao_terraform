n=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1342" height="56" as="geometry"/></mxCell><mxCell id="leg" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#8C99A6;" vertex="1" parent="1"><mxGeometry x="20" y="716" width="1342" height="181" as="geometry"/></mxCell><mxCell id="legt" value="&lt;b&gt;Jornada&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="34" y="724" width="300" height="20" as="geometry"/></mxCell><mxCell id="lega" value="&lt;b&gt;1.&lt;/b&gt; A equipe declara tipo, tamanho e hash; a API cria o item pendente.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; O navegador envia o PDF direto ao S3 com formulário assinado (tamanho exato, só PDF).&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; O bucket publica &amp;quot;Object Created&amp;quot; no EventBridge.&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; A Lambda confere tamanho, hash e conteúdo (sem JavaScript, sem anexo) e libera ou apaga.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="746" width="651.0" height="74" as="geometry"/></mxCell><mxCell id="legb" value="&lt;b&gt;5.&lt;/b&gt; O stream do DynamoDB entrega a mudança ao replicador.&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; Item e PDF vão para o GCP com credencial temporária (Workload Identity Federation).&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; O GCP reconhece a réplica pelo metadado de origem e não devolve: sem laço.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="697.0" y="746" width="651.0" height="57" as="geometry"/></mxCell><mxCell id="legn" value="• O caminho espelhado (enviado pelo GCP) usa Eventarc, Cloud Run eventos e a role federada na AWS.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="818" width="1302" height="23" as="geometry"/></mxCell><mxCell id="k0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="34" y="872" as="sourcePoint"/><mxPoint x="74" y="872" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt0" value="Fluxo principal" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="82" y="862" width="200" height="20" as="geometry"/></mxCell><mxCell id="k1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="284" y="872" as="sourcePoint"/><mxPoint x="324" y="872" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt1" value="Apoio, backup ou alternativo" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="332" y="862" width="200" height="20" as="geometry"/></mxCell><mxCell id="k2" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="545" y="863" width="18" height="18" as="geometry"/></mxCell><mxCell id="kt2" value="Passo da jornada" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="582" y="862" width="200" height="20" as="geometry"/></mxCell><mxCell id="k3" value="" style="rounded=1;arcSize=8;html=1;fillColor=none;strokeColor=#8C99A6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="784" y="863" width="40" height="18" as="geometry"/></mxCell><mxCell id="kt3" value="Fronteira de nuvem ou ambiente" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" par