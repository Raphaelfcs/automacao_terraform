t="18" as="geometry"/></mxCell><mxCell id="b5_1269" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1269" y="176.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b6_1289" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1289" y="334.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b6_1189" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1189" y="316.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b7_813" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="813" y="552.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="tit" value="&lt;b&gt;Upload, validation and replication of a PDF&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#545B64&quot;&gt;Event-driven in both clouds&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1342" height="56" as="geometry"/></mxCell><mxCell id="leg" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#8C99A6;" vertex="1" parent="1"><mxGeometry x="20" y="716" width="1342" height="181" as="geometry"/></mxCell><mxCell id="legt" value="&lt;b&gt;Flow&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="34" y="724" width="300" height="20" as="geometry"/></mxCell><mxCell id="lega" value="&lt;b&gt;1.&lt;/b&gt; Staff declares type, size and hash; the API creates the pending item.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; The browser uploads the PDF straight to S3 with a signed form (exact size, PDF only).&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; The bucket publishes &amp;quot;Object Created&amp;quot; to EventBridge.&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; The Lambda checks size, hash and content (no JavaScript, no attachment) and releases or deletes it.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="746" width="651.0" height="74" as="geometry"/></mxCell><mxCell id="legb" value="&lt;b&gt;5.&lt;/b&gt; The DynamoDB stream delivers the change to the replicator.&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; Item and PDF go to GCP with temporary credentials (Workload Identity Federation).&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; GCP recognizes the replica by its origin metadata and does not send it back: no loop.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="697.0" y="746" width="651.0" height="57" as="geometry"/></mxCell><mxCell id="legn" value="• The mirrored path (uploaded through GCP) uses Eventarc, Cloud Run events and the federated role on AWS.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="818" width="1302" height="23" as="geometry"/></mxCell><mxCell id="k0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="34" y="872" as="sourcePoint"/><mxPoint x="74" y="872" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt0" value="Main flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="82" y="862" width="200" height="20" as="geometry"/></mxCell><mxCell id="k1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="284" y="872" as="sourcePoint"/><mxPoint x="324" y="872" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt1" value="Support, backup or alternative" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="332" y="862" width="200" height="20" as="geometry"/></mxCell><mxCell id="k2" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="545" y="863" width="18" height="18" as="geometry"/></mxCell><mxCell id="kt2" value="Flow step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="582" y="862" width="200" height="20" as="geometry"/></mxCell><mxCell id="k3" value="" style="rounded=1;arcSize=8;html=1;fillColor=none;strokeColor=#8C99A6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="784" y="863" width="40" height="18" as="geometry"/></mxCell><mxCell id="kt3" value="Cloud or environment boundary" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="832" y="862" width="200" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="EN · Security and isolation per clinic and patient"><mxGraphModel dx="1160" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="900" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g0" value="AWS" style="html=1;whiteSpace=nowrap;verticalAlign=top;align=left;fontSize=11;fontStyle=1;container=0;collapsible=0;points=[];pointerEvents=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4