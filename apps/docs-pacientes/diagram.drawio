le="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="195" y="754.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="tit" value="&lt;b&gt;Documentos de pacientes: visão geral ativo-ativo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#545B64&quot;&gt;AWS e Google Cloud atendendo ao mesmo tempo, sem servidor ligado&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="960" height="56" as="geometry"/></mxCell><mxCell id="leg" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#8C99A6;" vertex="1" parent="1"><mxGeometry x="20" y="900" width="1020" height="164" as="geometry"/></mxCell><mxCell id="legt" value="&lt;b&gt;Jornada&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="34" y="908" width="300" height="20" as="geometry"/></mxCell><mxCell id="lega" value="&lt;b&gt;1.&lt;/b&gt; Paciente e equipe usam o mesmo endereço; o DNS responde com as duas nuvens.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Health check a cada 30 s: nuvem fora sai do DNS em cerca de 1 minuto.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; WAF/Cloud Armor filtram; /api/* vai para Lambda ou Cloud Run, que validam o token do Cognito.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="930" width="490.0" height="57" as="geometry"/></mxCell><mxCell id="legb" value="&lt;b&gt;4.&lt;/b&gt; Metadados no banco; o PDF sobe e desce direto do bucket por URL assinada de curta duração.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Cada escrita gera evento e é copiada para a outra nuvem (último escritor vence).&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="536.0" y="930" width="490.0" height="40" as="geometry"/></mxCell><mxCell id="legn" value="• Custo estimado: US$ 48/mês com 20 clínicas e US$ 75/mês com 100 (teto: US$ 200).&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="985" width="980" height="23" as="geometry"/></mxCell><mxCell id="k0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="34" y="1039" as="sourcePoint"/><mxPoint x="74" y="1039" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt0" value="Fluxo principal" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="82" y="1029" width="200" height="20" as="geometry"/></mxCell><mxCell id="k1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="284" y="1039" as="sourcePoint"/><mxPoint x="324" y="1039" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt1" value="Apoio, backup ou alternativo" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="332" y="1029" width="200" height="20" as="geometry"/></mxCell><mxCell id="k2" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="545" y="1030" width="18" height="18" as="geometry"/></mxCell><mxCell id="kt2" value="Passo da jornada" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="582" y="1029" width="200" height="20" as="geometry"/></mxCell><mxCell id="k3" value="" style="rounded=1;