ze=10;" vertex="1" parent="1"><mxGeometry x="155" y="176.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b2_403" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="403" y="176.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b3_651" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="651" y="158.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b4_671" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="671" y="194.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b5_403" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="403" y="316.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="tit" value="&lt;b&gt;Segurança e isolamento por clínica e paciente&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#545B64&quot;&gt;Quem acessa o quê, e com que credencial&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1120" height="56" as="geometry"/></mxCell><mxCell id="leg" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#8C99A6;" vertex="1" parent="1"><mxGeometry x="20" y="716" width="1120" height="164" as="geometry"/></mxCell><mxCell id="legt" value="&lt;b&gt;Jornada&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="34" y="724" width="300" height="20" as="geometry"/></mxCell><mxCell id="lega" value="&lt;b&gt;1.&lt;/b&gt; Login no Cognito com authorization code + PKCE; a equipe tem MFA obrigatório.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; As APIs das duas nuvens validam assinatura, emissor, expiração e app cliente do token.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Equipe só vê a própria clínica; paciente só os próprios documentos; a plataforma não lê documentos.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="746" width="540.0" height="57" as="geometry"/></mxCell><mxCell id="legb" value="&lt;b&gt;4.&lt;/b&gt; Todo download e envio vira registro de auditoria que o paciente consulta.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Entre nuvens só há credencial temporária: OIDC do Google na AWS e Workload Identity Federation no GCP.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="586.0" y="746" width="540.0" height="40" as="geometry"/></mxCell><mxCell id="legn" value="• Dados cifrados com chave do cliente nas duas nuvens; TLS 1.2+ em todo o caminho; nada de saúde fica em cache.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="801" width="1080" height="23" as="geometry"/></mxCell><mxCell id="k0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="34" y="855" as="sourcePoint"/><mxPoint x="74" y="855" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt0" value="Fluxo principal" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="82" y="845" width="200" height="20" as="geometry"/></mxCell><mxCell id="k1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545