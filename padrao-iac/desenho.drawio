nment&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1420" height="56" as="geometry"/></mxCell><mxCell id="leg" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#8C99A6;" vertex="1" parent="1"><mxGeometry x="20" y="384" width="1420" height="181" as="geometry"/></mxCell><mxCell id="legt" value="&lt;b&gt;Flow&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="34" y="392" width="300" height="20" as="geometry"/></mxCell><mxCell id="lega" value="&lt;b&gt;1.&lt;/b&gt; The project starts from the boilerplate with engines pinned by tag.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Every change goes through an MR/PR with review.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Static and security checks.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="414" width="690.0" height="57" as="geometry"/></mxCell><mxCell id="legb" value="&lt;b&gt;4.&lt;/b&gt; Plan per environment, saved as an artifact and posted on the PR.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Production and DR require manual approval.&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; Apply of the same plan with a temporary credential, no static key.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="736.0" y="414" width="690.0" height="57" as="geometry"/></mxCell><mxCell id="legn" value="• ~15 min per environment after the first resource.&lt;br&gt;• Same flow in GitLab CI, GitHub Actions and Azure DevOps.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="469" width="1380" height="40" as="geometry"/></mxCell><mxCell id="k0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="34" y="540" as="sourcePoint"/><mxPoint x="74" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt0" value="Main flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="82" y="530" width="200" height="20" as="geometry"/></mxCell><mxCell id="k1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="284" y="540" as="sourcePoint"/><mxPoint x="324" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt1" value="Support, backup or alternative" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="332" y="530" width="200" height="20" as="geometry"/></mxCell><mxCell id="k2" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="545" y="531" width="18" height="18" as="geometry"/></mxCell><mxCell id="kt2" value="Flow step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="582" y="530" width="200" height="20" as="geometry"/></mxCell><mxCell id="k3" value="" style="rounded=1;arcSize=8;html=1;fillColor=none;strokeColor=#8C99A6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="784" y="531" width="40" height="18" as="geometry"/></mxCell><mxCell id="kt3" value="Cloud or environment boundary" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="832" y="530" width="200" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
