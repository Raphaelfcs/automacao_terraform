tex="1" parent="1"><mxGeometry x="421" y="430.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b5_441" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="441" y="666.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b6_715" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="715" y="648.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b7_971" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="971" y="666.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="tit" value="&lt;b&gt;Padrão de IaC em monorepo: três esteiras&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#545B64&quot;&gt;Engine · boilerplate · workload&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1186" height="56" as="geometry"/></mxCell><mxCell id="leg" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#8C99A6;" vertex="1" parent="1"><mxGeometry x="20" y="952" width="1186" height="198" as="geometry"/></mxCell><mxCell id="legt" value="&lt;b&gt;Jornada&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="34" y="960" width="300" height="20" as="geometry"/></mxCell><mxCell id="lega" value="&lt;b&gt;1.&lt;/b&gt; A plataforma evolui as engines em branch de feature.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Review e aprovação; o merge na main gera uma tag semântica.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; O boilerplate usa as engines por tag e é testado num deploy de demonstração.&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; O time de produto cria o projeto a partir do boilerplate.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="982" width="573.0" height="74" as="geometry"/></mxCell><mxCell id="legb" value="&lt;b&gt;5.&lt;/b&gt; Toda mudança passa por PR com code review.&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; Pipeline faz init, validate, plan e apply por ambiente.&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; State remoto separado por projeto e ambiente, com lock.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="619.0" y="982" width="573.0" height="57" as="geometry"/></mxCell><mxCell id="legn" value="• Mesmo fluxo em GitLab CI, GitHub Actions e Azure DevOps.&lt;br&gt;• Primeiro recurso em 1-2 semanas; os seguintes em 1-2 dias e ~15 min por ambiente.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="1054" width="1146" height="40" as="geometry"/></mxCell><mxCell id="k0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="34" y="1125" as="sourcePoint"/><mxPoint x="74" y="1125" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt0" value="Fluxo principal" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="82" y="1115" width="200" height="20" as="geometry"/></mxCell><mxCell id="k1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="284" y="1125" as="sourcePoint"/><mxPoint x="324" y="1125" as="targetPoint"/></mxGeometry></mxCell><mx