18" as="geometry"/></mxCell><mxCell id="b5_441" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="441" y="666.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b6_709" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="709" y="648.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b7_965" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="965" y="666.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="tit" value="&lt;b&gt;IaC monorepo pattern: three pipelines&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#545B64&quot;&gt;Engine · boilerplate · workload&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1180" height="56" as="geometry"/></mxCell><mxCell id="leg" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#8C99A6;" vertex="1" parent="1"><mxGeometry x="20" y="952" width="1180" height="198" as="geometry"/></mxCell><mxCell id="legt" value="&lt;b&gt;Flow&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="34" y="960" width="300" height="20" as="geometry"/></mxCell><mxCell id="lega" value="&lt;b&gt;1.&lt;/b&gt; The platform team evolves engines on a feature branch.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Review and approval; merging to main creates a semantic tag.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; The boilerplate uses engines by tag and is tested in a demo deploy.&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; The product team creates its project from the boilerplate.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="982" width="570.0" height="74" as="geometry"/></mxCell><mxCell id="legb" value="&lt;b&gt;5.&lt;/b&gt; Every change goes through a PR with code review.&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; The pipeline runs init, validate, plan and apply per environment.&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; Remote state split per project and environment, with locking.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="616.0" y="982" width="570.0" height="57" as="geometry"/></mxCell><mxCell id="legn" value="• Same flow in GitLab CI, GitHub Actions and Azure DevOps.&lt;br&gt;• First resource in 1-2 weeks; next ones in 1-2 days and ~15 min per environment.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="1054" width="1140" height="40" as="geometry"/></mxCell><mxCell id="k0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="34" y="1125" as="sourcePoint"/><mxPoint x="74" y="1125" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt0" value="Main flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="82" y="1115" width="200" height="20" as="geometry"/></mxCell><mxCell id="k1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="284" y="1125" as="sourcePoint"/><mxPoint x="324" y="1125" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt1" value="Support, backup or alternative" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="332" y="1115" width="200" height="20" as="geometry"/></mxCell><mxCell id="k2" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="545" y="1116" width="18" height="18" as="geometry"/></mxCell><mxCell id="kt2" value="Flow step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="582" y="1115" width="200" height="20" as="geometry"/></mxCell><mxCell id="k3" value="" style="rounded=1;arcSize=8;html=1;fillColor=none;strokeColor=#8C99A6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="784" y="1116" width="40" height="18" as="geometry"/></mxCell><mxCell id="kt3" value="Cloud or environment boundary" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="832" y="1115" width="200" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="EN · Engine pipeline: from branch to tag"><mxGraphModel dx="1442" dy="462" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1442" pageHeight="462" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n_plat" value="Platform&lt;br&gt;engineer" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;fillColor=#232F3D;strokeColor=none;gradientColor=none;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="100" y="130" width="48" height="48" as="geometry"/></mxCell><mxCell id="n_feat" value="Branch&lt;br&gt;feature / release" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;fillColor=#C925D1;strokeColor=#ffffff;gradientColor=none;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.git_repository;" vertex="1" parent="1"><mxGeometry x="292" y="130" width="48" height="48" as="geometry"/></mxCell><mxCell id="n_ci" value="CI: fmt · validate&lt;br&gt;tflint · test · checkov" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E5A8F;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="424" y="126" width="120" height="56" as="geometry"/></mxCell><mxCell id="n_rev" value="Code review&lt;br&gt;(2 approvals)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="634" y="126" width="120" height="56" as="geometry"/></mxCell><mxCell id="n_rc" value="Release&lt;br&gt;candidate" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="850" y="126" width="120" height="56" as="geometry"/></mxCell><mxCell id="n_main" value="Merge to main" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;fillColor=#C925D1;strokeColor=#ffffff;gradientColor=none;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.git_repository;" vertex="1" parent="1"><mxGeometry x="1084" y="130" width="48" height="48" as="geometry"/></mxCell><mxCell id="n_tag" value="Semantic tag&lt;br&gt;engine-x/v1.4.0" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1258" y="126" width="120" height="56" as="geometry"/></mxCell><mxCell id="e0" value="push" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#007F85;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="n_plat" target="n_feat"><mxGeometry relative="1" as="geometry"><mxPoint x="148" y="154.0" as="sourcePoint"/><mxPoint x="292" y="154.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#007F85;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="n_feat" target="n_ci"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="154.0" as="sourcePoint"/><mxPoint x="424" y="154.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2" value="MR / PR" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#007F85;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="n_ci" target="n_rev"><mxGeometry relative="1" as="geometry"><mxPoint x="544" y="154.0" as="sourcePoint"/><mxPoint x="634" y="154.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e3" value="approved" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#007F85;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="n_rev" target="n_rc"><mxGeometry relative="1" as="geometry"><mxPoint x="754" y="154.0" as="sourcePoint"/><mxPoint x="850" y="154.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e4" value="merge" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#007F85;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="n_rc" target="n_main"><mxGeometry relative="1" as="geometry"><mxPoint x="970" y="154.0" as="sourcePoint"/><mxPoint x="1084" y="154.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e5" value="VERSION" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#007F85;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="n_main" target="n_tag"><mxGeometry relative="1" as="geometry"><mxPoint x="1132" y="154.0" as="sourcePoint"/><mxPoint x="1258" y="154.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b1_155" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="155" y="134.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b2_347" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="347" y="134.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b3_551" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="551" y="134.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b4_761" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="761" y="134.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="b5_1139" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1139" y="134.0" width="18" height="18" as="geometry"/></mxCell><mxCell id="tit" value="&lt;b&gt;Engine pipeline: from branch to tag&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#545B64&quot;&gt;Versioned and tested child modules&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1402" height="56" as="geometry"/></mxCell><mxCell id="leg" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#8C99A6;" vertex="1" parent="1"><mxGeometry x="20" y="244" width="1402" height="198" as="geometry"/></mxCell><mxCell id="legt" value="&lt;b&gt;Flow&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="34" y="252" width="300" height="20" as="geometry"/></mxCell><mxCell id="lega" value="&lt;b&gt;1.&lt;/b&gt; The engineer opens a feature or release branch.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; CI runs fmt, validate, tflint, terraform test and Checkov.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; MR/PR with code review; rejected work goes back to the branch.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="274" width="681.0" height="57" as="geometry"/></mxCell><mxCell id="legb" value="&lt;b&gt;4.&lt;/b&gt; Approved work becomes a release candidate.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Merging to main creates the tag from the VERSION file.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="727.0" y="274" width="681.0" height="40" as="geometry"/></mxCell><mxCell id="legn" value="• Boilerplates and workloads bump the version via PR, never automatically.&lt;br&gt;• Immutable tag: workloads never point to the engines main branch.&lt;br&gt;• Same flow in GitLab CI, GitHub Actions and Azure DevOps.&lt;br&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="329" width="1362" height="57" as="geometry"/></mxCell><mxCell id="k0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="34" y="417" as="sourcePoint"/><mxPoint x="74" y="417" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt0" value="Main flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="82" y="407" width="200" height="20" as="geometry"/></mxCell><mxCell id="k1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="284" y="417" as="sourcePoint"/><mxPoint x="324" y="417" as="targetPoint"/></mxGeometry></mxCell><mxCell id="kt1" value="Support, backup or alternative" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="332" y="407" width="200" height="20" as="geometry"/></mxCell><mxCell id="k2" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="545" y="408" width="18" height="18" as="geometry"/></mxCell><mxCell id="kt2" value="Flow step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="582" y="407" width="200" height="20" as="geometry"/>